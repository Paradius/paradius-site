# Base URL of the Paradius Core public API. Required: the build fetches profiles, cases and
# vocabulary from it, and the contact form island posts to it. api.paradius.dev has no certificate yet.
PUBLIC_API_BASE_URL=https://api-production-a13cc.up.railway.app

# Core token that only reads client rooms. Optional: unset, the build skips /room/ pages.
# Same value as ROOMS_API_TOKEN on the Core service; never the admin token.
ROOMS_API_TOKEN=
