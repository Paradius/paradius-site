# Base URL of Paradius Core public API (used at build time for data; also exposed to the contact form island)
# Leave empty or unset in local fixtures-only builds — the contact form falls back to mailto:solutions@paradius.dev
PUBLIC_API_BASE_URL=https://api.paradius.dev

# Data source for the build: "api" fetches from Paradius Core, "fixtures" reads local JSON
DATA_SOURCE=fixtures
