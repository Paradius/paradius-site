---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollBehavior from '../components/ScrollBehavior.astro';
import type { PageSeo } from '../lib/seo';
import '../styles/inner.css';
import { ART, CANOPY, CANOPY_SHARE, HERO_BESIDE, RAIL_SHARE, ROOTS, TREE_FACTOR, TRUNK_MAX, TRUNK_MIN, TWO_SIDED, applySeat, canopyLift, canopySide, scale, seat } from '../scripts/tree-geometry';

interface Props {
  seo: PageSeo;
  mode?: 'two-sided' | 'rail' | 'dossier';
  railBelow?: number;
  spine?: number;
}

const { seo, mode = 'two-sided', railBelow, spine } = Astro.props;
const below = mode === 'dossier' ? String(railBelow ?? 1200) : undefined;
// The same seating the tree module runs, inlined so the first layout carries the final geometry.
const seatScript = [
  `const ART = ${JSON.stringify(ART)}, CANOPY = ${JSON.stringify(CANOPY)}, ROOTS = ${JSON.stringify(ROOTS)}, TRUNK_MIN = ${TRUNK_MIN}, TRUNK_MAX = ${TRUNK_MAX}, CANOPY_SHARE = ${CANOPY_SHARE}, RAIL_SHARE = ${RAIL_SHARE}, TREE_FACTOR = ${TREE_FACTOR};`,
  scale.toString(),
  canopySide.toString(),
  canopyLift.toString(),
  seat.toString(),
  applySeat.toString(),
  `(function () {
    const main = document.querySelector('main.inner-main');
    const hero = document.querySelector('.inner-block--hero');
    if (!main || !hero) return;
    const railBelow = parseFloat(main.dataset.railBelow || '1200');
    const s = seat({
      mode: main.dataset.mode || 'two-sided',
      railBelow,
      spine: parseFloat(main.dataset.spine || ''),
      force: hero.dataset.force || 'power',
      frameWidth: main.getBoundingClientRect().width,
      pad: parseFloat(getComputedStyle(main).paddingLeft),
      svh: window.innerHeight,
      twoSided: matchMedia('${TWO_SIDED}').matches,
      heroBeside: matchMedia('${HERO_BESIDE}').matches,
      railBelowMatches: main.dataset.mode === 'dossier' && matchMedia('(max-width: ' + (railBelow - 0.02) + 'px)').matches,
    });
    if (s) applySeat(document.documentElement, s);
  })();`,
].join('\n');
---

<BaseLayout seo={seo}>
  <slot name="head" slot="head" />
  <Header />
  <main class="inner-main" id="main-content" data-mode={mode} data-rail-below={below} data-spine={spine} style={spine ? `--spine: ${spine}` : undefined}>
    <div class="inner-run" aria-hidden="true"></div>
    <slot />
    <script is:inline set:html={seatScript}></script>
  </main>
  <Footer />
  <ScrollBehavior />
  <script is:inline>
    // Scroll watcher, armed only with ?watch: records wheel input against scroll position and
    // reports a wheel burst that moves nothing while the page sits at an edge.
    // The variant sticks for the tab (sessionStorage) so the menu keeps it; ?watch=off clears it.
    let variant = new URLSearchParams(location.search).get('watch');
    if (variant === 'off') { sessionStorage.removeItem('watch'); variant = null; }
    else if (variant !== null) { variant = variant || 'plain'; sessionStorage.setItem('watch', variant); }
    else variant = sessionStorage.getItem('watch');
    if (variant) {
      const w = (window.__w = { t0: performance.now(), wheel: [], scroll: [], long: [], freezes: [], paints: [] });
      const run = document.querySelector('.inner-run');
      if (run) new MutationObserver(() => { const cs = getComputedStyle(run); w.paints.push([Math.round(performance.now()), run.style.height, (cs.maskImage || '').length, (cs.maskPosition || '').slice(0, 60), document.fonts.status, cs.opacity]); }).observe(run, { attributes: true, attributeFilter: ['style'] });
      const T = () => Math.round(performance.now() - w.t0);
      let stuckSince = 0;
      addEventListener('wheel', (e) => {
        const max = document.documentElement.scrollHeight - innerHeight;
        const y = Math.round(scrollY);
        const canMove = e.deltaY < 0 ? y > 0 : y < max;
        w.wheel.push([T(), Math.round(e.deltaY), y]);
        if (canMove) {
          if (!stuckSince) stuckSince = performance.now();
        }
      }, { passive: true, capture: true });
      addEventListener('scroll', () => { stuckSince = 0; w.scroll.push([T(), Math.round(scrollY)]); }, { passive: true });
      setInterval(() => {
        if (stuckSince && performance.now() - stuckSince > 300) {
          const rec = { at: T(), stuckMs: Math.round(performance.now() - stuckSince), y: Math.round(scrollY), lastWheel: w.wheel.slice(-5), lastScroll: w.scroll.slice(-3) };
          w.freezes.push(rec); console.warn('FREEZE', JSON.stringify(rec)); stuckSince = 0;
        }
      }, 100);
      new PerformanceObserver((l) => l.getEntries().forEach((e) => w.long.push([Math.round(e.startTime - w.t0), Math.round(e.duration)]))).observe({ type: 'longtask' });
      const css = { nomask: '.inner-run { mask-image: none !important; -webkit-mask-image: none !important; }', nowill: '.inner-run { will-change: auto !important; }', noheader: '.site-header { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; }', noafter: '.site-header::after { display: none !important; }', noanim: '.site-header::after { animation: none !important; opacity: 1 !important; }', notree: '.inner-run { display: none !important; }' }[variant];
      if (css) document.head.appendChild(Object.assign(document.createElement('style'), { textContent: css }));
      setInterval(() => console.info('WATCH variant=' + variant + ' freezes=' + w.freezes.length + ' wheel=' + w.wheel.length), 15000);
      console.info('watch armed', variant);
    }
  </script>
  <script>
    import { mountTreeRun } from '../scripts/tree-run';
    mountTreeRun();
  </script>
</BaseLayout>
