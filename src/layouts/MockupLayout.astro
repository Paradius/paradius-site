---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollBehavior from '../components/ScrollBehavior.astro';
import MockupBanner from '../components/mockups/MockupBanner.astro';
import type { PageSeo } from '../lib/seo';

interface Props {
  seo: PageSeo;
  variantLabel?: string;
}

const { seo, variantLabel } = Astro.props;
---

<BaseLayout seo={seo}>
  <MockupBanner variantLabel={variantLabel} />
  <Header />
  <main class="mockup-main">
    <slot />
  </main>
  <Footer />
  <ScrollBehavior />
</BaseLayout>
