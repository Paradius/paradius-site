---
/**
 * Base layout for every page: full SEO layer (meta, OG, Twitter, JSON-LD),
 * brand font loading, and theme metas.
 */
// Order is the cascade: tokens, base, shell, components, responsive tail.
// Concatenated in this order they are the stylesheet they replace.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/shell.css';
import '../styles/components.css';
import '../styles/responsive.css';
import { buildAllJsonLd, resolvePageMeta, type PageSeo } from '../lib/seo';
import { classifyDevice } from '../scripts/device-class';

interface Props {
  seo: PageSeo;
}

const { seo } = Astro.props;
const meta = resolvePageMeta(seo);
const jsonLdBlocks = [
  ...buildAllJsonLd(seo),
  ...(seo.additionalJsonLd ?? []),
];

/**
 * Exported so a page can opt into a BLOCKING copy of the same stylesheet.
 * The home needs it: its settle model measures the landing after
 * `document.fonts.ready`, and the non-blocking media=print load lets that
 * promise resolve before the brand faces swap in, freezing a layout that is
 * ~104px too tall.
 */
export const GOOGLE_FONTS_URL =
  'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&family=Quantico:wght@400;700&family=Zilla+Slab:wght@300;400&display=fallback';

const deviceClassScript = `document.documentElement.setAttribute('data-device',(${classifyDevice.toString()})({platform:navigator.userAgentData&&navigator.userAgentData.platform,userAgent:navigator.userAgent,maxTouchPoints:navigator.maxTouchPoints||0,coarsePointer:window.matchMedia?window.matchMedia('(pointer: coarse)').matches:undefined}));`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={deviceClassScript} />

    <!-- Primary Meta Tags -->
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={meta.robots} />
    <meta name="author" content={meta.author} />
    <meta name="keywords" content={meta.keywords} />
    <!-- The copy is the product: Chrome offers to translate an English page for
         a phone set to another language, and its bar lands on the lockup. -->
    <meta name="google" content="notranslate" />
    <link rel="canonical" href={meta.canonical} />

    <!-- Geo targeting -->
    <meta name="geo.region" content={meta.geoRegion} />
    <meta name="geo.placename" content={meta.geoPlacename} />

    <!-- Open Graph / LinkedIn -->
    <meta property="og:type" content={meta.ogType} />
    <meta property="og:url" content={meta.ogUrl} />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:site_name" content={meta.ogSiteName} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:image" content={meta.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content={meta.twitterCard} />
    <meta name="twitter:title" content={meta.twitterTitle} />
    <meta name="twitter:description" content={meta.twitterDescription} />
    <meta name="twitter:site" content={meta.twitterSite} />
    <meta name="twitter:image" content={meta.twitterImage} />

    <!-- JSON-LD structured data -->
    {
      jsonLdBlocks.map((block) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(block).replace(/</g, '\\u003c')}
        />
      ))
    }

    <!-- Theme -->
    <meta name="theme-color" content="#000000" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="Paradius" />
    <meta name="application-name" content="Paradius" />

    <!-- Fonts: preconnect + non-render-blocking load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Render-blocking on purpose: an async font stylesheet arrives after the first paint, so every
         navigation repainted all text and the tree in the fallback font first (2026-09-23). -->
    <link rel="stylesheet" href={GOOGLE_FONTS_URL} />

    <!-- Favicon: real files at the root. Search engines skip data: URIs and
         want /favicon.ico at a multiple of 48px; the black tile keeps the
         isotype visible on light result pages. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
