---
/**
 * Base layout for every page: full SEO layer (meta, OG, Twitter, JSON-LD),
 * brand font loading, and theme metas.
 */
import '../styles/global.css';
import { buildAllJsonLd, resolvePageMeta, type PageSeo } from '../lib/seo';
import { classifyDevice } from '../scripts/device-class';

interface Props {
  seo: PageSeo;
}

const { seo } = Astro.props;
const meta = resolvePageMeta(seo);
const jsonLdBlocks = [
  ...buildAllJsonLd(seo),
  ...(seo.additionalJsonLd ?? []),
];

/**
 * Exported so a page can opt into a BLOCKING copy of the same stylesheet.
 * The home needs it: its settle model measures the landing after
 * `document.fonts.ready`, and the non-blocking media=print load lets that
 * promise resolve before the brand faces swap in, freezing a layout that is
 * ~104px too tall.
 */
export const GOOGLE_FONTS_URL =
  'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&family=Quantico:wght@400;700&family=Zilla+Slab:wght@300;400&display=swap';

const FAVICON_DATA_URI =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 364.41 774.56'%3E%3Cpath d='M196.04,774.56v-392.04l-27.65,27.65.16,295.54-125.43-127.76,66.69-67.8v68.68l30.82-30.81v-110.13l-37.52,37.52h0s-37.47,37.46-37.47,37.46h0s-37.49,37.5-37.49,37.5h0s-28.14,28.14-28.14,28.14l5.54,5.56.02.03h0l37.46,37.47,37.5,37.5,34.3,34.29,37.49,37.5.02.02h0l37.45,37.47h.01l6.22,6.22ZM168.37,0v392.04l27.65-27.65-.16-295.54,125.43,127.76-66.69,67.8v-68.68l-30.82,30.81v110.13l37.52-37.52h0s37.47-37.46,37.47-37.46h0s37.5-37.5,37.5-37.5h0s28.14-28.14,28.14-28.14l-5.54-5.56-.02-.03h0l-37.46-37.47-37.5-37.5-34.3-34.29-37.49-37.5-.02-.02h0L174.6,6.22h-.01l-6.22-6.22Z' fill='white'/%3E%3C/svg%3E";

const deviceClassScript = `document.documentElement.setAttribute('data-device',(${classifyDevice.toString()})({platform:navigator.userAgentData&&navigator.userAgentData.platform,userAgent:navigator.userAgent,maxTouchPoints:navigator.maxTouchPoints||0,coarsePointer:window.matchMedia?window.matchMedia('(pointer: coarse)').matches:undefined}));`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={deviceClassScript} />

    <!-- Primary Meta Tags -->
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={meta.robots} />
    <meta name="author" content={meta.author} />
    <meta name="keywords" content={meta.keywords} />
    <!-- The copy is the product: Chrome offers to translate an English page for
         a phone set to another language, and its bar lands on the lockup. -->
    <meta name="google" content="notranslate" />
    <link rel="canonical" href={meta.canonical} />

    <!-- Geo targeting -->
    <meta name="geo.region" content={meta.geoRegion} />
    <meta name="geo.placename" content={meta.geoPlacename} />

    <!-- Open Graph / LinkedIn -->
    <meta property="og:type" content={meta.ogType} />
    <meta property="og:url" content={meta.ogUrl} />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:site_name" content={meta.ogSiteName} />
    <meta property="og:locale" content={meta.ogLocale} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content={meta.twitterCard} />
    <meta name="twitter:title" content={meta.twitterTitle} />
    <meta name="twitter:description" content={meta.twitterDescription} />
    <meta name="twitter:site" content={meta.twitterSite} />

    <!-- JSON-LD structured data -->
    {
      jsonLdBlocks.map((block) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(block).replace(/</g, '\\u003c')}
        />
      ))
    }

    <!-- Theme -->
    <meta name="theme-color" content="#000000" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="Paradius" />
    <meta name="application-name" content="Paradius" />

    <!-- Fonts: preconnect + non-render-blocking load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={GOOGLE_FONTS_URL}
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href={GOOGLE_FONTS_URL} rel="stylesheet" />
    </noscript>

    <!-- Favicon (isotype SVG) -->
    <link rel="icon" type="image/svg+xml" href={FAVICON_DATA_URI} />

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
