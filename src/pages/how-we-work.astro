---
import InnerLayout from '../layouts/InnerLayout.astro';
import InnerBlock from '../components/inner/InnerBlock.astro';
import '../styles/inner-tools.css';
import { SITE_URL, type PageSeo } from '../lib/seo';

const seo: PageSeo = {
  title: 'How We Work | Paradius LLC',
  description:
    'Two ways to buy, a reply within 24 hours, profiles within 48, and what happens when something goes wrong. Staff augmentation without the agency theater.',
  canonical: `${SITE_URL}/how-we-work/`,
  webPageName: 'How we work',
  webPageDescription:
    'The Paradius operating model for buyers: engagement models, timeline, continuity, replacement, IP and jurisdiction.',
};
---

<InnerLayout seo={seo} mode="two-sided" spine={0.25}>
  <InnerBlock force="power" kind="hero" title="How we work">
    <p>
      Every engineer we send was interviewed by the person who signs your contract. From
      your first message to the years after we leave, this is how it works.
    </p>
  </InnerBlock>

  <div class="inner-stop" style={`--stop: 0`}>
    <InnerBlock force="power" kind="tool" ariaLabel="Today" className="inner-stop__clock">
      <p class="inner-kicker inner-stop__when">Today</p>
    </InnerBlock>
    <InnerBlock force="will" kind="tool" ariaLabel="You write" className="inner-stop__story">
      <h2 class="inner-title">You write</h2>
      <div class="inner-body">
        <p>
          Tell us who or what you need: the contact form, or
          <a href="mailto:solutions@paradius.dev">solutions@paradius.dev</a>.
        </p>
        <p>
          <strong>Browse the registry.</strong> Pick engineers, interview them, run them inside
          your team. You manage the day to day; we answer for quality, continuity and
          replacement.
        </p>
        <p>
          <strong>Start your team.</strong> Describe the outcome. We assemble the team, run the
          day to day, and answer for delivery. You set the goals and review the progress.
        </p>
      </div>
    </InnerBlock>
  </div>

  <div class="inner-stop" style={`--stop: 0.17`}>
    <InnerBlock force="power" kind="tool" ariaLabel="Within 24 hours" className="inner-stop__clock">
      <p class="inner-kicker inner-stop__when">Within 24 hours</p>
    </InnerBlock>
    <InnerBlock force="will" kind="tool" ariaLabel="We reply" className="inner-stop__story">
      <h2 class="inner-title">We reply</h2>
      <div class="inner-body">
        <p>
          A reply from the principal, with matched profiles or precise questions.
        </p>
        <p>
          Rates come with it, and requirements set them: a senior engineer embedded in a
          regulated bank is not a line on a rate card. We scope them against your actual
          architecture, in private.
        </p>
      </div>
    </InnerBlock>
  </div>

  <div class="inner-stop" style={`--stop: 0.33`}>
    <InnerBlock force="power" kind="tool" ariaLabel="Within 48 hours" className="inner-stop__clock">
      <p class="inner-kicker inner-stop__when">Within 48 hours</p>
    </InnerBlock>
    <InnerBlock force="will" kind="tool" ariaLabel="Profiles" className="inner-stop__story">
      <h2 class="inner-title">Profiles</h2>
      <div class="inner-body">
        <p>
          Anonymized, and verifiable in one call: stack, years, experience, languages. Our
          engineers carry codes instead of names; full identity is disclosed later in the
          deal, off platform.
        </p>
      </div>
    </InnerBlock>
  </div>

  <div class="inner-stop" style={`--stop: 0.5`}>
    <InnerBlock force="power" kind="tool" ariaLabel="Before day one" className="inner-stop__clock">
      <p class="inner-kicker inner-stop__when">Before day one</p>
    </InnerBlock>
    <InnerBlock force="will" kind="tool" ariaLabel="The paper" className="inner-stop__story">
      <h2 class="inner-title">The paper</h2>
      <div class="inner-body">
        <p>
          Contracts are with Paradius LLC, Wyoming, under US jurisdiction, billed in USD. The
          IP is yours from day one. NDAs are signed by default. Your systems carry no
          signature of ours.
        </p>
      </div>
    </InnerBlock>
  </div>

  <div class="inner-stop" style={`--stop: 0.67`}>
    <InnerBlock force="power" kind="tool" ariaLabel="Day one" className="inner-stop__clock">
      <p class="inner-kicker inner-stop__when">Day one</p>
    </InnerBlock>
    <InnerBlock force="will" kind="tool" ariaLabel="In one room" className="inner-stop__story">
      <h2 class="inner-title">In one room</h2>
      <div class="inner-body">
        <p>
          Every engagement begins in one room: our hub in Managua, Nicaragua, on Central Time
          with full overlap with US business hours. A senior mentor at the next desk,
          standards enforced from day one. Then they go remote. And nothing degrades, because
          the discipline travels with them.
        </p>
      </div>
    </InnerBlock>
  </div>

  <div class="inner-stop" style={`--stop: 0.83`}>
    <InnerBlock force="power" kind="tool" ariaLabel="If it goes wrong" className="inner-stop__clock">
      <p class="inner-kicker inner-stop__when">If it goes wrong</p>
    </InnerBlock>
    <InnerBlock force="will" kind="tool" ariaLabel="Replacement" className="inner-stop__story">
      <h2 class="inner-title">Replacement</h2>
      <div class="inner-body">
        <p>
          Every engineer passes three months with us before reaching a client, so a bad fit
          is rare. When it happens, say so. We transition to another engineer quickly, because
          context is documented and shared from day one; it never lives in one head. Nobody
          here is disposable. Almost nobody leaves.
        </p>
      </div>
    </InnerBlock>
  </div>


  <div class="inner-stop" style={`--stop: 1`}>
    <InnerBlock force="power" kind="tool" ariaLabel="Years later" className="inner-stop__clock">
      <p class="inner-kicker inner-stop__when">Years later</p>
    </InnerBlock>
    <InnerBlock force="will" kind="tool" ariaLabel="If we disappear" className="inner-stop__story">
      <h2 class="inner-title">If we disappear</h2>
      <div class="inner-body">
        <p>
          The question you are too polite to ask: what if Paradius disappears tomorrow?
          Nothing happens to you. Every system we build ships with documentation, repositories
          and credentials in your accounts. Your team keeps shipping. That is written into how
          we work, and it is why our clients' systems are still standing years after we left
          them. We disappear into your success.
        </p>
      </div>
    </InnerBlock>
  </div>

  <InnerBlock force="power" kind="cta" title="Tell us who you need.">
    <p>We reply within 24 hours. Profiles within 48.</p>
    <Fragment slot="actions">
      <a href="/talent" class="inner-button">Browse the registry</a>
      <a href="/contact" class="inner-button inner-button--secondary">Start your team</a>
    </Fragment>
  </InnerBlock>
</InnerLayout>
