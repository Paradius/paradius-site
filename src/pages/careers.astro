---
import InnerLayout from '../layouts/InnerLayout.astro';
import InnerBlock from '../components/inner/InnerBlock.astro';
import { SITE_URL, type PageSeo } from '../lib/seo';

const seo: PageSeo = {
  title: 'Careers | Paradius LLC',
  description:
    'We do not hire headcount. We find the ones with the spark and push them further than they believed they could go.',
  canonical: `${SITE_URL}/careers/`,
  webPageName: 'Careers at Paradius',
  webPageDescription:
    'How engineers join Paradius: referrals, the hub, the mentor, and the push.',
};
---

<InnerLayout seo={seo} mode="two-sided">
  <InnerBlock force="will" kind="hero" title="Careers">
    <p>
      We look for the spark, and then we push it further than you would on your own.
    </p>
  </InnerBlock>

  <InnerBlock force="will">
    <p>
      You start at our hub in Managua, beside a senior mentor, with the bar set on your
      first day. When you go remote, the bar goes with you.
    </p>
    <p>
      Performance pays: bonuses follow what you ship. Training is continuous:
      multicultural communication, languages, the platforms you have not touched yet.
    </p>
    <p>
      On client systems you carry a code instead of a name. The client keeps the glory;
      you keep the growth, and it compounds.
    </p>
  </InnerBlock>

  <InnerBlock force="power" kind="cta">
    <p>Designed by an engineer, for engineers. We keep the people we find.</p>
    <p>
      Positions open through referrals and by watching who builds what. If you think we
      should be watching you, write:
      <a href="mailto:solutions@paradius.dev">solutions@paradius.dev</a>.
    </p>
  </InnerBlock>
</InnerLayout>
