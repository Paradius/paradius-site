---
import InnerLayout from '../layouts/InnerLayout.astro';
import InnerBlock from '../components/inner/InnerBlock.astro';
import { SITE_URL, type PageSeo } from '../lib/seo';

const seo: PageSeo = {
  title: 'About | Paradius LLC',
  description:
    'Who answers for Paradius: one principal who interviews every engineer and signs every contract. Wyoming LLC, Managua hub, full US overlap.',
  canonical: `${SITE_URL}/about/`,
  webPageName: 'About Paradius',
  webPageDescription:
    'Who runs Paradius, how its engineers are grown, and where it operates from.',
};
---

<InnerLayout seo={seo} mode="two-sided">
  <InnerBlock force="will" kind="hero" kicker="About" title="I am the person who answers.">
    <p>
      Paradius is engineering tailored to one company at a time, with me in the trench. I
      interview every engineer, I read every message, and I sign the same contract you
      sign.
    </p>
  </InnerBlock>

  <InnerBlock force="will" title="What Paradius does differently">
    <p>
      Everything is built around how we work. An engagement takes the shape of your
      company: your problem, your stack, your pace. Our engineers start in one room, beside
      a senior mentor, inside an environment made for collaboration, and they grow at a
      rate that surprises the people who hire them. That environment travels with them
      when they go remote.
    </p>
    <p>
      I am a full stack engineer with more than six years of experience. In every company
      I have worked for, I built the systems that changed how the company saw itself from
      the inside, and I went the extra mile because a closed ticket was never the goal. I
      leave things better than I found them. That is the standard every engineer at
      Paradius is held to, and it is the reason someone hires us twice.
    </p>
    <p class="inner-signature">Gabriel Chorens, principal</p>
  </InnerBlock>

  <InnerBlock force="power" title="The facts">
    <p>
      Paradius LLC, Wyoming, USA. Hub in Managua, Nicaragua, on Central Time: full overlap
      with US business hours. Operating since 2026. A small core, and vetted engineers
      activated per contract.
    </p>
  </InnerBlock>

  <InnerBlock force="power" kind="cta" title="Tell us who you need.">
    <p>We reply within 24 hours. Profiles within 48.</p>
    <Fragment slot="actions">
      <a href="/talent" class="inner-button">Browse the registry</a>
      <a href="/contact" class="inner-button inner-button--secondary">Start your team</a>
    </Fragment>
  </InnerBlock>
</InnerLayout>
