---
import InnerLayout from '../layouts/InnerLayout.astro';
import InnerBlock from '../components/inner/InnerBlock.astro';
import {
  SITE_URL,
  buildBreadcrumbJsonLd,
  buildFaqPageJsonLd,
  type PageSeo,
} from '../lib/seo';

const FAQ_ITEMS: { question: string; answer: string; force: 'will' | 'power' }[] = [
  {
    question: 'Where is Paradius located?',
    answer:
      'Paradius LLC is registered in Wyoming, USA. The engineering hub is in Managua, Nicaragua. Contracts, jurisdiction and billing are all US based.',
    force: 'power',
  },
  {
    question: 'What is your timezone overlap with the US?',
    answer:
      'Full overlap. The hub runs on Central Time, so your team and ours share the whole business day.',
    force: 'power',
  },
  {
    question: 'What about English?',
    answer:
      'Our engineers work in English every day, and language training is continuous.',
    force: 'will',
  },
  {
    question: 'Who do I contract with?',
    answer:
      'With Paradius LLC, a Wyoming company, under US jurisdiction, billed in USD.',
    force: 'power',
  },
  {
    question: 'Who owns the IP?',
    answer:
      'You do, from day one. Everything built during an engagement is yours: code, documentation, infrastructure. Your systems carry no signature of ours.',
    force: 'power',
  },
  {
    question: 'Do you sign NDAs?',
    answer:
      'By default, before we see anything of yours. Discretion is not a concession here; it is the product.',
    force: 'power',
  },
  {
    question: 'Why do engineers carry codes instead of names?',
    answer:
      'Policy, not evasion. The code protects the engineer and keeps your systems free of our signature. Stack, years, experience and languages are verifiable right now; the name arrives later in the deal, off platform. Behind every code there is one person, interviewed by the principal, and one call confirms it.',
    force: 'will',
  },
  {
    question: 'What if an engineer is not the right fit?',
    answer:
      'Say so. A bad fit is rare: every engineer spends three months with us before meeting a client. When it happens, the transition is quick, because the context was written down and shared from the first day.',
    force: 'will',
  },
  {
    question: 'What if an engineer leaves mid engagement?',
    answer:
      'Work is documented as it happens and the principal stays close to every engagement, so the context already lives in more than one head. The handover is short because it was prepared before it was needed.',
    force: 'will',
  },
  {
    question: 'What happens to my systems if Paradius disappears?',
    answer:
      'Nothing changes for you. Documentation, repositories and credentials live in your accounts from the first commit, so your team keeps shipping without us.',
    force: 'power',
  },
  {
    question: 'Why is there no pricing on the site?',
    answer:
      'Because the price follows the requirements. The same seniority costs one thing on a greenfield product and another inside a regulated bank, so we scope rates against your actual architecture, in private, and send them with the first reply.',
    force: 'power',
  },
  {
    question: 'What exactly am I buying: an engineer, a team, or a project?',
    answer:
      'One of two things. Engineers from the registry that you manage inside your team, or a team we assemble and run against your goals.',
    force: 'power',
  },
  {
    question: 'What do you not do?',
    answer:
      'We are honest about limits. Hyper specialized niches, like robotics research or frontier AI model work, are not what we sell. Architecture, platforms, mobile, back end systems and the discipline that keeps them alive: that is what we sell.',
    force: 'power',
  },
  {
    question: 'How do you select engineers?',
    answer:
      'No algorithmic screening. No credential theater. We examine the systems an engineer has built, not their resume, and we talk: what they refuse to ship tells us more than what they list. The last filter is always the person who signs your contract.',
    force: 'will',
  },
  {
    question: 'How fast can we start?',
    answer:
      'A reply inside 24 hours, profiles inside 48, and the engagement starts the day you confirm.',
    force: 'power',
  },
];

const seo: PageSeo = {
  title: 'FAQ | Paradius LLC',
  description:
    'Timezone overlap, contracts, IP, NDAs, replacement policy, the code system and why there is no pricing. The questions a buyer asks before signing.',
  canonical: `${SITE_URL}/faq/`,
  webPageName: 'Frequently Asked Questions',
  webPageDescription: 'Due diligence answers for Paradius buyers.',
  additionalJsonLd: [
    buildFaqPageJsonLd(FAQ_ITEMS, `${SITE_URL}/faq/`),
    buildBreadcrumbJsonLd([
      { name: 'Home', url: `${SITE_URL}/` },
      { name: 'FAQ', url: `${SITE_URL}/faq/` },
    ]),
  ],
};
---

<InnerLayout seo={seo} mode="two-sided">
  <InnerBlock force="power" kind="hero" kicker="FAQ" title="Every answer is a policy we hold, not a promise we improvise.">
    <p>
      The questions a buyer asks before signing. If yours is missing, write to
      <a href="mailto:solutions@paradius.dev">solutions@paradius.dev</a> and we reply
      within 24 hours.
    </p>
  </InnerBlock>

  {FAQ_ITEMS.map((item) => (
    <InnerBlock force={item.force} title={item.question}>
      <p>{item.answer}</p>
    </InnerBlock>
  ))}

  <InnerBlock force="power" kind="cta" title="Tell us who you need.">
    <p>We reply within 24 hours. Profiles within 48.</p>
    <Fragment slot="actions">
      <a href="/talent" class="inner-button">Browse the registry</a>
      <a href="/contact" class="inner-button inner-button--secondary">Start your team</a>
    </Fragment>
  </InnerBlock>
</InnerLayout>
