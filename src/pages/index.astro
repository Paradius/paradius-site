---
import BaseLayout, { GOOGLE_FONTS_URL } from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HOME_SEO } from '../lib/seo';

// Copy source of truth: PRODUCT.md (libreto v3). Left = Power, right = Will,
// center = the unified. Placement is meaning; never mechanical alternation.
---

<BaseLayout seo={HOME_SEO}>
  <link
    slot="head"
    rel="preload"
    href="/assets/architecting_the_dawn_from_within.svg"
    as="image"
  />
  {/*
    BLOCKING copy of the brand stylesheet, on purpose. The settle model freezes
    the landing offset right after `document.fonts.ready`; with only the layout's
    non-blocking (media=print) load, that promise can resolve before Inter and
    Cormorant swap in, and the hero is measured against a layout ~104px too tall.
    Loading here starts the faces before the script runs, so fonts.ready waits
    for them. Same URL as the layout: the browser dedupes the request.
  */}
  <link slot="head" rel="stylesheet" href={GOOGLE_FONTS_URL} />

  <Header />

  <div class="home-v7">
    <div class="home-v7__tree" data-home-v7-tree aria-hidden="true"></div>
    <div class="home-v7__tree-shimmer home-v7__tree-shimmer--s1" data-home-v7-tree-shimmer aria-hidden="true"></div>
    <div class="home-v7__tree-shimmer home-v7__tree-shimmer--s2" data-home-v7-tree-shimmer aria-hidden="true"></div>
    <div class="home-v7__tree-shimmer home-v7__tree-shimmer--s3" data-home-v7-tree-shimmer aria-hidden="true"></div>
    <div class="home-v7__tree-shimmer home-v7__tree-shimmer--s4" data-home-v7-tree-shimmer aria-hidden="true"></div>
    <div class="home-v7__tree-shimmer home-v7__tree-shimmer--s5" data-home-v7-tree-shimmer aria-hidden="true"></div>

    <main id="main-content" class="home-v7__main">
      <!-- HERO: roots, centered -->
      <section class="home-v7__hero" aria-labelledby="hero-heading">
        <div class="home-v7__hero-inner">
          <h1 id="hero-heading" class="sr-only">
            Paradius: Architecting the Dawn from Within | Software Engineering Consultancy
          </h1>
          <img
            class="home-v7__tagline"
            src="/assets/architecting_the_dawn_from_within.svg"
            alt="Paradius: Architecting the Dawn from Within"
            width="288"
            height="97"
            fetchpriority="high"
            decoding="async"
          />
          <div class="home-v7__actions">
            <a href="/talent" class="home-v7__cta">Browse the registry</a>
            <a href="/contact" class="home-v7__cta home-v7__cta--secondary">Start your team</a>
          </div>
        </div>
      </section>

      <!-- THE CONFESSION: center, a full viewport of its own. Typographic peak 1. -->
      <section
        class="home-v7__row home-v7__row--confession"
        data-home-v7-node
        id="philosophy"
        aria-label="The confession"
      >
        <div class="home-v7__injerto-wrap">
          <div class="home-v7__clip home-v7__clip--center">
            <p class="home-v7__peak-lead">
              We are the ones who see the world not as it is, but as it ought to be. The ones
              who do not halt at impossible, for impossible is only ground no one has broken
              yet.
            </p>
            <p class="home-v7__peak home-v7__peak--confession" id="confession">
              Theirs is the glory. Ours is the road.
            </p>
          </div>
        </div>
      </section>

      <!-- THE THESIS: first fork of the spine. Power falls left, Will falls right. -->
      <section class="home-v7__row" data-home-v7-node id="thesis" aria-label="The thesis">
        <div class="home-v7__injerto-wrap">
          <div class="home-v7__clip home-v7__clip--center">
            <p class="home-v7__peak home-v7__peak--confession">
              Everything begins as the union of two fundamental forces: the capacity to
              create, and the desire to make it real.
            </p>
            <p class="home-v7__peak-lead home-v7__peak-lead--after-peak">
              Missing either, a dream stays a blueprint.
            </p>
          </div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--split" data-home-v7-node aria-label="Power and Will">
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left">
            <div class="home-v7__content home-v7__clip home-v7__clip--left home-v7__content--depth-2">
              <span class="home-v7__force-label home-v7__force-label--power">Power</span>
              <p class="home-v7__force-text home-v7__force-text--power">
                Architecture before code. Guardrails on every line shipped. The discipline
                that keeps systems from rotting.
              </p>
            </div>
          </div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right home-v7__col--hang">
            <div class="home-v7__content home-v7__clip home-v7__clip--right home-v7__content--depth-1">
              <span class="home-v7__force-label home-v7__force-label--will">Will</span>
              <p class="home-v7__force-text home-v7__force-text--will">
                Engineers chosen for the spark, not the resume. People who cannot leave
                things worse than they found them.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--thesis-close" data-home-v7-node aria-label="Both forces">
        <div class="home-v7__injerto-wrap">
          <div class="home-v7__clip home-v7__clip--center">
            <p class="home-v7__peak home-v7__peak--confession home-v7__peak--dim">
              Every system that endures needs both.
            </p>
            <p class="home-v7__peak home-v7__peak--confession">
              We seal them together in a creational force.
            </p>
          </div>
        </div>
      </section>

      <!-- THE ENGINE: trunk. Real mechanics, sides per meaning. -->
      <section class="home-v7__row home-v7__row--branch home-v7__row--left home-v7__row--pair" data-home-v7-node id="engine" aria-label="The engine">
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left">
            <div class="home-v7__content home-v7__clip home-v7__clip--left home-v7__content--loose">
              <p class="home-v7__voice home-v7__voice--slab home-v7__voice--pump">
                That force takes form in our hub.
              </p>
            </div>
          </div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right home-v7__col--empty"></div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--branch home-v7__row--tuck home-v7__row--right home-v7__row--pair" data-home-v7-node>
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left home-v7__col--empty"></div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right">
            <div class="home-v7__content home-v7__clip home-v7__clip--right home-v7__content--loose">
              <article class="home-v7__ops-block">
                <p class="home-v7__force-text home-v7__force-text--will home-v7__force-text--compact">
                  One senior mentor alongside every new recruit. Shared context. Knowledge and
                  craft pass on naturally and take root.
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--branch home-v7__row--right home-v7__row--pair" data-home-v7-node>
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left home-v7__col--empty"></div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right">
            <div class="home-v7__content home-v7__clip home-v7__clip--right home-v7__content--loose">
              <article class="home-v7__ops-block">
                <p class="home-v7__force-text home-v7__force-text--will">
                  In that network, visions, projects and ideas grow stronger and more resilient.
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--branch home-v7__row--left home-v7__row--pair" data-home-v7-node>
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left">
            <div class="home-v7__content home-v7__clip home-v7__clip--left home-v7__content--loose">
              <article class="home-v7__ops-block">
                <p class="home-v7__voice home-v7__voice--slab">
                  When they go remote, Paradius becomes less of a company and more of a mindset
                  performing through them.
                </p>
              </article>
            </div>
          </div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right home-v7__col--empty"></div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--branch home-v7__row--right home-v7__row--pair" data-home-v7-node aria-label="The engine, extended">
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left home-v7__col--empty"></div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right">
            <div class="home-v7__content home-v7__clip home-v7__clip--right home-v7__content--loose">
              <article class="home-v7__ops-block">
                <p class="home-v7__force-text home-v7__force-text--will">
                  Enforced standards and close communication extend the hub into a virtual space
                  where constant learning sets the pace.
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--branch" data-home-v7-node aria-label="The engine close">
        <div class="home-v7__injerto-wrap">
          <div class="home-v7__clip home-v7__clip--center">
            <p class="home-v7__peak home-v7__peak--confession">
              What we forge here, your systems inherit.
            </p>
            <p class="home-v7__graft home-v7__graft--center">
              <a href="/how-we-work">Read how we work</a>
            </p>
          </div>
        </div>
      </section>

      <!-- THE PROOFS: two fruits, left and right branches. The result is the
           citable line; the title is a label; the grounding runs gray. -->
      <section
        class="home-v7__row home-v7__row--branch home-v7__row--left home-v7__row--pair"
        style="--row-air-top: clamp(9rem, 24vh, 16rem)"
        data-home-v7-node
        id="proofs"
        aria-label="The proofs"
      >
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left">
            <div class="home-v7__content home-v7__clip home-v7__clip--left home-v7__content--loose">
              <article class="home-v7__ops-block">
                <h2 class="home-v7__ops-title">Warehouse automation</h2>
                <p class="home-v7__voice home-v7__voice--slab">
                  Robots, inventory and hundreds of services moving as one.
                </p>
                <p class="home-v7__force-text home-v7__force-text--will home-v7__force-text--lead-size">
                  A Fortune 500 retailer now runs it across its network.
                </p>
              </article>
              <a
                class="home-v7__graft-link"
                href="/work/fortune-500-home-improvement-retailer/">Read the engagement</a
              >
            </div>
          </div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right home-v7__col--empty"></div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--branch home-v7__row--tuck home-v7__row--right home-v7__row--pair" data-home-v7-node>
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left home-v7__col--empty"></div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right">
            <div class="home-v7__content home-v7__clip home-v7__clip--right home-v7__content--loose">
              <article class="home-v7__ops-block">
                <h2 class="home-v7__ops-title">Banking infrastructure</h2>
                <p class="home-v7__voice home-v7__voice--slab">
                  Payments stopped going missing. Delays became guarantees.
                </p>
                <p class="home-v7__force-text home-v7__force-text--will home-v7__force-text--lead-size">
                  Systems are still standing, untouched by us.
                </p>
              </article>
              <a class="home-v7__graft-link" href="/work/banking-infrastructure/"
                >Read the engagement</a
              >
            </div>
          </div>
        </div>
      </section>

      <!-- COPA: registry left (Power: the codes), work right (Will: what was achieved) -->
      <section class="home-v7__row home-v7__row--cup" data-home-v7-cup>
        <div class="home-v7__cup-grid">
          <article
            class="home-v7__cup-col home-v7__cup-col--registry home-v7__clip home-v7__clip--left"
            id="talent-teaser"
            aria-label="The registry"
          >
            <p class="home-v7__text">
              Curated professionals whose work outlives their names. Within your reach in 48
              hours.
            </p>
            <p class="home-v7__graft">Entirely in your hands. Your back covered by ours.</p>
            <a href="/talent" class="home-v7__teaser-cta">Browse the registry</a>
          </article>

          <article
            class="home-v7__cup-col home-v7__clip home-v7__clip--right"
            id="work-teaser"
            aria-label="The work"
          >
            <p class="home-v7__text">
              The road behind us. Every system we left standing is a milestone the next one is
              built on.
            </p>
            <p class="home-v7__graft">Anonymized, because results speak louder than names.</p>
            <a href="/work" class="home-v7__teaser-cta">View case studies</a>
          </article>
        </div>
      </section>

      <!-- THE CANOPY: the dawn. Last in the document, so the top of the scroll
           lands here: the closing hero, cards beneath it. -->
      <section
        class="home-v7__row home-v7__row--dawn"
        style="--row-air-top: clamp(3.5rem, 9vh, 6rem); --row-air-bottom: clamp(7.5rem, 23vh, 15rem)"
        data-home-v7-node
        id="assurance"
        aria-label="The dawn"
      >
        <div class="home-v7__injerto-wrap">
          <div class="home-v7__clip home-v7__clip--center">
            <div class="home-v7__dawn">
              <p
                class="home-v7__peak home-v7__peak--confession home-v7__peak--oneline"
                data-text="There is a dawn only you can see."
              >
                There is a dawn only you can see.
              </p>
              <p
                class="home-v7__peak-lead home-v7__peak-lead--after-peak home-v7__peak-lead--oneline"
                data-text="Let the ones who break the ground clear your way to it."
              >
                Let the ones who break the ground clear your way to it.
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <Footer />
  <script src="../scripts/home-v7.ts"></script>
  <script is:inline>
    /* Clicking the page steps the tree's light through the accent family.
       (The shimmer twins follow the trunk via CSS vars written by the
       engine; the old mirror rAF loop is gone.) */
    (function () {
      const root = document.querySelector('.home-v7');
      if (!root) return;
      const tints = ['#ffffff', '#c0c8d4', '#8fa3c0', '#e5e7eb'];
      let step = 0;
      document.addEventListener('click', function (ev) {
        if (ev.target && ev.target.closest && ev.target.closest('a, button')) return;
        step = (step + 1) % tints.length;
        root.style.setProperty('--tree-tint', tints[step]);
      });
    })();
  </script>
</BaseLayout>

<style>
  :global(body:has(.home-v7))::before {
    opacity: 0 !important;
  }

  :global(body:has(.home-v7) .site-header) {
    background-color: rgb(0 0 0 / 0.82);
  }

  .home-v7 {
    position: relative;
    isolation: isolate;
  }

  /* Tree layers share one geometry; the engine drives them through TWO
     variables (--tree-shift, --tree-fade) written on .home-v7, so the
     shimmer twins follow the trunk with no mirror JS loop. */
  .home-v7__tree,
  .home-v7__tree-shimmer {
    position: fixed;
    top: 0;
    /* Owner calibration: the trunk reads left of center, nudge right */
    left: calc(50% + 1.2vw);
    z-index: 0;
    /* EXPERIMENT: expanded like the original landing tree (was min(96vw, 88rem)) */
    width: 165vw;
    height: 220dvh;
    pointer-events: none;
    transform: translateX(-50%) translateY(var(--tree-shift, -50vh));
    background-color: var(--tree-tint, #fff);
  }

  .home-v7__tree {
    opacity: var(--tree-fade, 0.04);
    -webkit-mask-image: url('/assets/circuit_tree_full.svg');
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center center;
    -webkit-mask-size: 100% 86%;
    mask-image: url('/assets/circuit_tree_full.svg');
    mask-repeat: no-repeat;
    mask-position: center center;
    mask-size: 100% 86%;
    will-change: transform, opacity;
  }

  /* EXPERIMENT: heartbeat sweep from the original landing (tree shape
     intersected with a vertical glow band, slowly rising). Sibling of the
     tree because the engine drives the tree's inline opacity each frame. */
  .home-v7__tree-shimmer {
    /* Shimmer brightness rides the trunk's fade, amplified and capped. */
    opacity: min(0.3, calc(var(--tree-fade, 0.04) * 4));
    contain: strict;
    will-change: transform;
    /* One source for the 4-layer mask (tree shape intersected with the
       traveling wave, the per-column window, and the height-intensity cap);
       both vendor properties consume the same token. */
    --shimmer-mask:
      url('/assets/circuit_tree_full.svg'),
      linear-gradient(
        to top,
        transparent 0%,
        transparent 12%,
        rgb(255 255 255 / 0.35) 18%,
        transparent 24%,
        transparent 36%,
        rgb(255 255 255 / 0.9) 44%,
        rgb(255 255 255 / 0.9) 48%,
        transparent 56%,
        transparent 66%,
        rgb(255 255 255 / 0.5) 72%,
        transparent 78%,
        transparent 100%
      ),
      linear-gradient(
        to right,
        transparent 0%,
        transparent var(--seg-a),
        #fff calc(var(--seg-a) + 5%),
        #fff calc(var(--seg-b) - 5%),
        transparent var(--seg-b),
        transparent 100%
      ),
      linear-gradient(
        to top,
        rgb(255 255 255 / 0.3) 0%,
        rgb(255 255 255 / 0.45) 30%,
        rgb(255 255 255 / 0.75) 60%,
        #fff 85%,
        #fff 100%
      );
    --shimmer-mask-size: 100% 86%, 100% 350%, 100% 100%, 100% 100%;
    --shimmer-mask-position: center center, center 280%, center center, center center;
    -webkit-mask-image: var(--shimmer-mask);
    -webkit-mask-size: var(--shimmer-mask-size);
    -webkit-mask-repeat: no-repeat, no-repeat;
    -webkit-mask-position: var(--shimmer-mask-position);
    -webkit-mask-composite: source-in;
    mask-image: var(--shimmer-mask);
    mask-size: var(--shimmer-mask-size);
    mask-repeat: no-repeat, no-repeat;
    mask-position: var(--shimmer-mask-position);
    mask-composite: intersect;
    clip-path: inset(
      0
      max(0%, calc(98% - var(--seg-b)))
      0
      max(0%, calc(var(--seg-a) - 2%))
    );
    animation: home-v7-tree-pulse 20s linear infinite;
  }

  .home-v7__tree-shimmer--s1 {
    --seg-a: 36%;
    --seg-b: 64%;
    animation-delay: 0s;
  }

  .home-v7__tree-shimmer--s2 {
    --seg-a: 16%;
    --seg-b: 42%;
    animation-delay: 1.1s;
  }

  .home-v7__tree-shimmer--s3 {
    --seg-a: 58%;
    --seg-b: 84%;
    animation-delay: 1.7s;
  }

  .home-v7__tree-shimmer--s4 {
    --seg-a: 0%;
    --seg-b: 22%;
    animation-delay: 2.6s;
  }

  .home-v7__tree-shimmer--s5 {
    --seg-a: 78%;
    --seg-b: 100%;
    animation-delay: 3.1s;
  }

  @keyframes home-v7-tree-pulse {
    0% {
      -webkit-mask-position: center center, center -180%, center center, center center;
      mask-position: center center, center -180%, center center, center center;
    }
    100% {
      -webkit-mask-position: center center, center 280%, center center, center center;
      mask-position: center center, center 280%, center center, center center;
    }
  }

  .home-v7__main {
    position: relative;
    z-index: 1;
    overflow-x: hidden;
  }

  /* Spine grid: full bleed, gutters scale with viewport */
  .home-v7__spine {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(2.5rem, 4.5vw, 5rem) minmax(0, 1fr);
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: var(--bleed-pad);
    align-items: start;
  }

  .home-v7__axis {
    /* empty: perception only */
  }

  /* The forces stagger (WILL high, POWER lower) but hug the spine; their
     text runs longer than the default measure (owner call, 2026-08-30). */
  .home-v7__row--split .home-v7__col--left {
    margin-top: clamp(5rem, 12vh, 9rem);
    padding-right: clamp(0.5rem, 1vw, 1.25rem);
    align-self: start;
    padding-top: 0;
  }

  .home-v7__row--split .home-v7__col--right {
    padding-left: clamp(0.5rem, 1vw, 1.25rem);
    /* WILL climbs above POWER (owner call) */
    margin-top: clamp(-6.5rem, -9vh, -3.5rem);
  }

  .home-v7__col--left {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .home-v7__col--right {
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Branch depth: each block starts at a different distance from spine or edge */
  .home-v7__content {
    width: min(100%, var(--content-span, 46ch));
    max-width: none;
  }

  .home-v7__col--left .home-v7__content {
    padding-inline-end: var(--branch-gap, clamp(0.5rem, 2vw, 2rem));
    margin-inline-start: var(--branch-push, 0);
  }

  .home-v7__col--right .home-v7__content {
    padding-inline-start: var(--branch-gap, clamp(0.5rem, 2vw, 2rem));
    margin-inline-end: var(--branch-push, 0);
  }

  .home-v7__content--depth-1 {
    --branch-push: clamp(0rem, 2vw, 1.5rem);
    --branch-gap: clamp(0.75rem, 2.5vw, 2.5rem);
    --content-span: 44ch;
  }

  .home-v7__content--depth-2 {
    --branch-push: clamp(1rem, 7vw, 6rem);
    --branch-gap: clamp(0.5rem, 1.5vw, 1.25rem);
    --content-span: 40ch;
  }

  .home-v7__content--depth-3 {
    --branch-push: clamp(0.25rem, 4.5vw, 3.5rem);
    --branch-gap: clamp(1.25rem, 3.5vw, 3rem);
    --content-span: 50ch;
  }

  .home-v7__content--loose {
    --branch-push: clamp(0.5rem, 3vw, 2rem);
    --branch-gap: clamp(0.75rem, 2.5vw, 2.5rem);
    --content-span: 64ch;
  }

  /* Dual-branch row */
  .home-v7__row--split .home-v7__col--hang {
    align-self: start;
    padding-top: clamp(0.75rem, 2.5vh, 1.5rem);
  }

  .home-v7__row--split .home-v7__content--depth-2 {
    --branch-push: clamp(1.5rem, 9vw, 8rem);
    --content-span: 52ch;
  }

  .home-v7__row--split .home-v7__content--depth-1 {
    --branch-push: clamp(0rem, 3vw, 2rem);
    --content-span: 54ch;
  }

  /* Row rhythm: sparse libreto. Every line earns its air, and consecutive
     same-side rows need clearance for the 0.55vh settle pull-down.

     ONE knob per row: vertical air comes only from --row-air (or the
     --row-air-top / --row-air-bottom overrides). Modifiers set the variables,
     NEVER margin properties: a margin rule placed before this base was
     silently dead (same-specificity cascade), which already bit us twice.
     Precedence inside this section is the declaration order below. */
  .home-v7__row {
    --row-air: clamp(6rem, 17vh, 12.5rem);
    margin-block-start: var(--row-air-top, var(--row-air));
    margin-block-end: var(--row-air-bottom, var(--row-air));
    scroll-margin-top: calc(var(--site-header-height) + 1.5rem);
  }

  .home-v7__hero + .home-v7__row {
    --row-air-top: clamp(0.5rem, 1.25vh, 1rem);
  }

  .home-v7__row--pair {
    --row-air-top: clamp(2.5rem, 8vh, 6rem);
  }

  .home-v7__row--cup {
    --row-air-bottom: clamp(8rem, 18vh, 14rem);
  }

  /* Branch cluster: tight rhythm so the blocks read as limbs off the trunk. */
  .home-v7__row--branch {
    --row-air: clamp(1.5rem, 4vh, 3rem);
    --row-air-top: clamp(1.5rem, 4vh, 3rem);
  }

  /* Tuck: negative top air pulls a branch row into the previous one, so
     opposite-side blocks stagger closely instead of stacking with air. */
  .home-v7__row--tuck {
    --row-air-top: clamp(-9rem, -12vh, -5rem);
  }

  /* Hero */
  .home-v7__hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    box-sizing: border-box;
    padding-top: var(--site-header-height);
    padding-bottom: clamp(0.75rem, 2vh, 1.5rem);
    margin-block: 0;
  }

  .home-v7__hero-inner {
    text-align: center;
    max-width: 1500px;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .home-v7__tagline {
    display: block;
    width: 44vw;
    max-width: 880px;
    height: auto;
    margin-inline: auto;
    /* The retired facts line used to sit here; its air stays (owner call). */
    margin-bottom: calc(var(--spacing-lg) * 1.65);
    opacity: 0;
    transform: translateY(1.5rem);
    filter: brightness(0) invert(1);
    -webkit-mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 78%);
    -webkit-mask-size: 100% 300%;
    -webkit-mask-position: 0% 0%;
    mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 78%);
    mask-size: 100% 300%;
    mask-position: 0% 0%;
    animation: home-v7-dawn-rise 1.4s var(--ease-brand) 0.15s both;
  }

  @keyframes home-v7-dawn-rise {
    0% {
      opacity: 0;
      transform: translateY(1.5rem);
      mask-position: 0% 0%;
      -webkit-mask-position: 0% 0%;
      filter: brightness(0) invert(0.35) drop-shadow(0 0 0 rgb(214 206 188 / 0));
    }

    55% {
      opacity: 1;
      filter: brightness(0) invert(1) drop-shadow(0 0 34px rgb(214 206 188 / 0.3));
    }

    100% {
      opacity: 1;
      transform: translateY(0);
      mask-position: 0% 100%;
      -webkit-mask-position: 0% 100%;
      filter: brightness(0) invert(1) drop-shadow(0 0 18px rgb(200 208 220 / 0.14));
    }
  }

  /* The line of facts: policies and facts only, never counts. Static in the
     DOM, no settle classes. Shares the quiet rise of the hero actions. */

  .home-v7__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    justify-content: center;
    opacity: 0;
    transform: translateY(0.75rem);
    animation: home-v7-quiet-rise 0.7s var(--ease-brand) 0.75s both;
  }

  @keyframes home-v7-quiet-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* One CTA skeleton, two skins: --cta-fg/--cta-bg pick the polarity.
     Hero CTAs run dark (bg ground, white text); teaser CTAs inverted. */
  .home-v7__cta,
  .home-v7__teaser-cta {
    display: inline-block;
    padding: var(--cta-pad, 0.875rem 2.5rem);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--cta-fg, var(--color-text-primary));
    background-color: var(--cta-bg, var(--color-bg));
    border: 1px solid var(--color-text-primary);
    text-decoration: none;
    transition:
      background-color var(--transition-duration-base) ease,
      color var(--transition-duration-base) ease;
  }

  .home-v7__cta:hover,
  .home-v7__cta:focus-visible {
    --cta-fg: var(--color-bg);
    --cta-bg: var(--color-text-primary);
  }

  .home-v7__teaser-cta {
    --cta-fg: var(--color-bg);
    --cta-bg: var(--color-text-primary);
    --cta-pad: 0.75rem 2rem;
    margin-top: var(--spacing-md);
  }

  .home-v7__teaser-cta:hover,
  .home-v7__teaser-cta:focus-visible {
    --cta-fg: var(--color-text-primary);
    --cta-bg: transparent;
  }

  /* Typography */
  .home-v7__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-heading);
    margin: 0 0 var(--spacing-md);
    line-height: 1.15;
  }

  .home-v7__title--sm {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .home-v7__title--slab {
    font-family: var(--font-voice);
    font-weight: 300;
  }

  .home-v7__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .home-v7__text {
    /* Same size as the confession lead ("Missing either, ...") */
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Operation-style blocks (Power statements, proofs) */
  .home-v7__ops-block + .home-v7__ops-block {
    margin-top: var(--spacing-lg);
  }

  .home-v7__row--left .home-v7__ops-block {
    text-align: right;
    border-right: 2px solid var(--color-accent);
    padding-right: var(--spacing-md);
  }

  .home-v7__row--right .home-v7__ops-block {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--spacing-md);
  }

  .home-v7__ops-title {
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    margin: 0 0 var(--spacing-xs);
  }

  .home-v7__ops-text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Grafts: the flat register that carries the reader out of the story and
     into the site. They ride the settle of the block they are born in. */
  .home-v7__graft {
    font-family: var(--font-body);
    /* Caption size, page-wide: matches the ops-title (fruit labels). */
    font-size: var(--fs-caption);
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: var(--spacing-sm) 0 0;
  }

  .home-v7__graft--center {
    text-align: center;
    max-width: 46ch;
    margin-inline: auto;
    margin-top: var(--spacing-md);
  }

  .home-v7__graft-link {
    display: inline-block;
    margin-top: var(--spacing-sm);
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    line-height: 1.75;
  }

  /* Permanent underline: color alone is roughly 1.5:1 against the graft text,
     which is not enough to mark a link on its own. */
  .home-v7__graft a,
  .home-v7__graft-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    transition: color var(--transition-duration-base) ease;
  }

  .home-v7__graft a:hover,
  .home-v7__graft a:focus-visible,
  .home-v7__graft-link:hover,
  .home-v7__graft-link:focus-visible {
    color: var(--color-text-primary);
  }

  /* Center rows share the full-bleed wrap */
  .home-v7__injerto-wrap {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: var(--bleed-pad);
  }

  /* Copa */
  .home-v7__cup-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* Wide center gap: the trunk runs between the cards, so give it room. */
    gap: clamp(3.5rem, 8vw, 8rem);
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: clamp(1.5rem, 6vw, 6rem);
  }

  .home-v7__cup-col {
    padding: clamp(1.25rem, 3vh, 2rem) var(--spacing-lg);
    /* Actual transparent glass: faint white tint, crisp pane edge, light
       top sheen. The tree stays readable through it, barely softened.
       Diagonal tint: darker at top-left, clearing toward the right. */
    background-color: transparent;
    background-image: linear-gradient(
      105deg,
      rgb(0 0 0 / 0.32) 0%,
      rgb(0 0 0 / 0.1) 45%,
      rgb(255 255 255 / 0.05) 100%
    );
    backdrop-filter: blur(1.5px);
    -webkit-backdrop-filter: blur(1.5px);
    border: 1px solid rgb(255 255 255 / 0.28);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.28),
      inset 1px 0 0 rgb(255 255 255 / 0.16),
      inset 0 -1px 0 rgb(0 0 0 / 0.45),
      inset -1px 0 0 rgb(0 0 0 / 0.3),
      inset 0 0 24px rgb(255 255 255 / 0.03);
  }

  /* Libreto voices (PRODUCT.md): peaks, voice lines, force labels */
  .home-v7__row--confession {
    display: flex;
    align-items: center;
    min-height: 56vh;
  }

  .home-v7__peak-lead {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: var(--fs-lead);
    line-height: 1.6;
    letter-spacing: var(--tracking-heading);
    color: var(--color-text-secondary);
    text-align: center;
    max-width: 52ch;
    margin: 0 auto var(--spacing-md);
  }

  .home-v7__peak {
    font-weight: 300;
    font-family: var(--font-heading);
    font-size: clamp(2.3rem, 4.8vw, 4rem);
    line-height: 1.28;
    letter-spacing: var(--tracking-heading);
    color: var(--color-text-primary);
    text-align: center;
    max-width: 26ch;
    margin: 0 auto;
  }

  .home-v7__peak-lead--after-peak {
    margin-block-start: var(--spacing-lg);
  }

  .home-v7__peak--confession {
    /* EXPERIMENT: Zilla Slab 300 for the citable line (lab direction D) */
    font-family: var(--font-voice);
    font-weight: 300;
    font-size: clamp(1.9rem, 3.8vw, 3.1rem);
    max-width: 30ch;
  }

  .home-v7__peak em {
    font-weight: 500;
    font-style: italic;
    color: var(--color-accent);
  }

  /* The thesis close: near the forces but with clearance from WILL's climb */
  .home-v7__row--thesis-close {
    margin-block-start: clamp(18rem, 32vh, 25rem);
  }

  .home-v7__peak--dim {
    color: var(--color-text-secondary);
  }

  /* Dawn closure: title and subtitle each on a single line. The title runs
     larger than the confession scale so the final frame carries the epic. */
  .home-v7__peak--oneline,
  .home-v7__peak-lead--oneline {
    max-width: none;
  }

  .home-v7__peak--oneline {
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    position: relative;
    /* Own stacking context so the z:-1 clone sits behind the glyphs but
       still above the tree layer (without this it falls below the tree). */
    isolation: isolate;
  }

  /* Dawn glow: a blurred clone of the letterforms behind the crisp ones,
     so the halo is the text itself melting into light, not a painted color. */
  .home-v7__peak--oneline::before {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    filter: blur(10px);
    opacity: 0.55;
    pointer-events: none;
  }

  /* Luminous darkness for the gray line: the blurred clone runs BLACK and
     wide, quenching the tree lines around the letters into a shadow aura. */
  .home-v7__peak-lead--oneline {
    position: relative;
    isolation: isolate;
    margin-block-start: clamp(0.75rem, 2vh, 1.5rem);
  }

  .home-v7__peak-lead--oneline::before {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    color: rgb(var(--ink-dark));
    font-weight: 700;
    /* Same-radius shadows stack multiplicatively: this is what gives the
       darkness enough body to quench the tree lines around the glyphs. */
    text-shadow:
      0 0 12px rgb(var(--ink-dark)),
      0 0 12px rgb(var(--ink-dark)),
      0 0 12px rgb(var(--ink-dark)),
      0 0 12px rgb(var(--ink-dark)),
      0 0 12px rgb(var(--ink-dark)),
      0 0 12px rgb(var(--ink-dark)),
      0 0 30px rgb(var(--ink-dark)),
      0 0 30px rgb(var(--ink-dark)),
      0 0 30px rgb(var(--ink-dark));
    filter: blur(4px);
    pointer-events: none;
  }


  .home-v7__voice {
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 2.7vw, 2.25rem);
    line-height: 1.45;
    color: var(--color-text-primary);
    margin: 0;
  }

  .home-v7__voice--slab {
    font-family: var(--font-voice);
    font-weight: 300;
  }

  .home-v7__force-text--compact {
    max-width: 18ch;
  }

  .home-v7__voice--pump {
    font-size: clamp(2rem, 3.6vw, 3rem);
    max-width: 16ch;
    margin-inline-start: auto;
    text-align: right;
  }

  .home-v7__voice--slab + .home-v7__force-text,
  .home-v7__force-text + .home-v7__voice--slab {
    margin-block-start: var(--spacing-xs);
  }

  .home-v7__voice--center {
    text-align: center;
    max-width: 34ch;
    margin-inline: auto;
  }

  .home-v7__force-label {
    /* Inscription jurisdiction: caps, spaced. Marcellus baseline. */
    display: block;
    font-family: var(--font-tech);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-sm);
  }

  /* The two forces share ONE hierarchy: same scale, different timbre.
     Power defaults to the sans voice, Will to the heading voice. */
  .home-v7__force-text {
    font-family: var(--font-tech);
    font-size: var(--fs-force, clamp(calc(1.65rem - 2px), calc(2.7vw - 2px), calc(2.25rem - 2px)));
    line-height: 1.45;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .home-v7__force-text--power {
    color: var(--color-text-primary);
  }

  /* The forces differ by light, not by face: POWER white, WILL gray, both tech. */
  .home-v7__force-label--will {
    color: var(--color-text-secondary);
  }

  .home-v7__force-text--will {
    color: var(--color-text-secondary);
  }

  /* Fruit grounding line: the confession-lead size, not the force size.
     Sets the variable, not the property: order-immune per the repo rule. */
  .home-v7__force-text--lead-size {
    --fs-force: var(--fs-lead);
  }

  .home-v7__row--dawn {
    display: flex;
    align-items: center;
  }

  .home-v7__dawn {
    text-align: center;
    max-width: none;
    margin-inline: auto;
  }

  /* ---- Motion contract ---------------------------------------------------
     The engine (home-v7.ts) writes ONLY lifecycle scalars per clip:
     --settle (build, 0..1) and --exit (0..1), plus the --live/--moving
     state classes. ALL appearance derives here, so every dial is a CSS
     token, tunable live in devtools:
       --pull-x / --pull-y  collapsed offset toward the spine and below.
                            CRITICAL: --pull-y must exceed the settle entry
                            window (SETTLE_ENTRY_END * 100vh) or the scroll
                            flow cancels the ascent and the birth reads as a
                            horizontal wipe.
       --exit-pull          extra downward travel while funnel-exiting
       --scale-pull         collapsed shrink (anchored at the spine-bottom
                            corner via transform-origin below)
       --fade-delay         build fraction where opacity starts rising
     Elements without --live (mobile, reduced motion, static blocks) get no
     motion styles at all: no !important overrides needed anywhere. */
  .home-v7 {
    /* Type scale tokens: one definition per recurring size. */
    --fs-lead: clamp(calc(1.1rem + 2px), calc(1.9vw + 2px), calc(1.45rem + 2px));
    --fs-caption: calc(0.9375rem + 2px);
    /* Full-bleed gutter shared by the spine grid and edge-running rows. */
    --bleed-pad: clamp(1rem, 5vw, 5rem);
    --pull-x: 6vh;
    --pull-y: 85vh;
    --exit-pull: 16vh;
    --scale-pull: 0.06;
    --fade-delay: 0.55;
  }

  .home-v7__clip--left {
    /* Anchor at spine edge and bottom: growth comes from below during the ascent */
    --sign: 1;
    transform-origin: right bottom;
  }

  .home-v7__clip--right {
    --sign: -1;
    transform-origin: left bottom;
  }

  .home-v7__clip--center {
    --sign: 0;
    transform-origin: center bottom;
  }

  .home-v7__clip--live {
    --rest: calc(1 - var(--settle, 1));
    --fade: clamp(
      0,
      calc(
        (var(--settle, 1) - var(--fade-delay)) / (1 - var(--fade-delay)) *
          (1 - var(--exit, 0))
      ),
      1
    );
    backface-visibility: hidden;
    opacity: var(--fade);
    filter: brightness(calc(0.5 + 0.5 * var(--fade)));
    transform: translate3d(
        calc(var(--sign, 0) * var(--rest) * var(--pull-x)),
        calc(var(--rest) * var(--pull-y) + var(--exit, 0) * var(--exit-pull)),
        0
      )
      scale(calc(1 - var(--rest) * var(--scale-pull)));
  }

  /* Layer promotion only while the engine reports motion: permanent
     will-change on every clip held ~15 large textures alive at rest. */
  .home-v7__clip--moving {
    will-change: transform, opacity, filter;
  }

  /* ---- Presentation glow -----------------------------------------------
     Driven by --settle (0..1), written per clip by the settle engine.
     Tokens live in ONE place:
       --glow       the lifecycle ramp: 0 through most of the build, rises in
                    the settle's last stretch, dies with the funnel exit
                    (alpha/opacity clamp the out-of-range values).
       --ink-dark   tone of the luminous-darkness pool (never pure black, or
                    it vanishes against the page background).
       --ink-mist   the cold rim that keeps the darkness readable over black.
     Elements outside the engine (cards, mobile, reduced motion) fall back to
     --glow 1: static glow. White text radiates a dim halo of its own
     letterforms; gray text pools darkness that quenches the tree lines. */
  .home-v7 {
    --glow-start: 0.7;
    /* Journey purity scale (written by the engine, 0 roots .. 1 canopy):
       the gray ink slides from bluish dusk to pure black, the white halo
       from a whisper to full radiance, and the blue rim recedes as the
       darkness purifies. */
    --j: var(--journey, 1);
    --ink-dark: calc(24 * (1 - var(--j))) calc(28 * (1 - var(--j))) calc(40 * (1 - var(--j)));
    --ink-mist: 205 208 215;
    --white-purity: calc(0.3 + 0.7 * var(--j));
    --mist-purity: calc(1 - 0.45 * var(--j));
  }

  /* The glow reads the COARSE settle channel (--settle-q, 0.05 steps), not
     the fine one that drives transforms: the prophecy clones carry big
     blurred rasters, and repainting their opacity per frame during the
     canopy ramp was a visible stutter at the top of the page. */
  .home-v7__clip {
    --glow: calc((var(--settle-q, 1) - var(--glow-start)) / (1 - var(--glow-start)));
  }

  .home-v7__peak-lead:not(.home-v7__peak-lead--oneline),
  .home-v7__peak--dim,
  .home-v7__force-text,
  .home-v7__force-label--will,
  .home-v7__ops-title,
  .home-v7__ops-text,
  .home-v7__text,
  .home-v7__graft,
  .home-v7__graft-link {
    /* Static rasters on purpose: a var()-driven alpha invalidates paint on
       every settle step and stutters the scroll. The clip's own opacity
       fade (compositor-only) carries the glow in and out instead. */
    text-shadow:
      0 0 10px rgb(var(--ink-dark) / 0.95),
      0 0 10px rgb(var(--ink-dark) / 0.95),
      0 0 10px rgb(var(--ink-dark) / 0.95),
      0 0 30px rgb(var(--ink-dark) / 0.8),
      0 0 30px rgb(var(--ink-dark) / 0.8),
      0 0 32px rgb(var(--ink-dark) / 0.6),
      0 0 30px rgb(var(--ink-mist) / calc(0.2 * var(--mist-purity, 1))),
      0 0 36px rgb(var(--ink-mist) / calc(0.11 * var(--mist-purity, 1)));
  }

  .home-v7__peak:not(.home-v7__peak--dim),
  .home-v7__voice,
  .home-v7__force-text--power,
  .home-v7__force-label--power {
    text-shadow:
      0 0 12px rgb(255 255 255 / calc(0.38 * var(--white-purity, 1))),
      0 0 26px rgb(255 255 255 / calc(0.26 * var(--white-purity, 1))),
