---
import InnerLayout from '../layouts/InnerLayout.astro';
import InnerBlock from '../components/inner/InnerBlock.astro';
import { SITE_URL, type PageSeo } from '../lib/seo';

const seo: PageSeo = {
  title: 'Page Not Found | Paradius',
  description: 'Not every path leads to the dawn.',
  // Self-referencing canonical: with noindex below, it keeps the 404 from
  // consolidating any signal onto another URL.
  canonical: `${SITE_URL}/404/`,
  robots: 'noindex, follow',
  webPageName: 'Page not found',
  webPageDescription: '404 page for paradius.dev.',
};
---

<InnerLayout seo={seo} mode="two-sided">
  <InnerBlock force="will" kind="hero" title="Not every path leads to the dawn.">
    <p>This one does not exist. These do.</p>
  </InnerBlock>

  <InnerBlock force="power" kind="cta">
    <p><a href="/">Or begin at the roots</a></p>
    <Fragment slot="actions">
      <a href="/talent" class="inner-button">Browse the registry</a>
      <a href="/contact" class="inner-button inner-button--secondary">Start your team</a>
    </Fragment>
  </InnerBlock>
</InnerLayout>
