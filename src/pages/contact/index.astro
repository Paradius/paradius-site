---
import InnerLayout from '../../layouts/InnerLayout.astro';
import InnerBlock from '../../components/inner/InnerBlock.astro';
import ContactForm from '../../components/contact/ContactForm.astro';
import { CONTACT_EMAIL } from '../../lib/contact/constants';
import { buildContactSeo } from '../../lib/seo';
import '../../styles/inner-tools.css';

const seo = buildContactSeo();
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? '';
---

<InnerLayout seo={seo} mode="rail">
  <InnerBlock force="power" kind="hero" kicker="Start a conversation" title="Start your team">
    <Fragment slot="after">
      <ContactForm apiBaseUrl={apiBaseUrl} />
    </Fragment>
  </InnerBlock>

  <InnerBlock force="power" id="terms" title="Every engagement is scoped to your architecture.">
    <p>
      Tell us who you need, or what, here or at
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. We reply within 24 hours
      with matched profiles and a rate proposal, scoped against your architecture in
      private.
    </p>
  </InnerBlock>
</InnerLayout>

<script src="../../islands/contact-form.ts"></script>
