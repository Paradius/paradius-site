---
import MockupLayout from '../../layouts/MockupLayout.astro';
import ProfileEditorialA from '../../components/mockups/ProfileEditorialA.astro';
import { getProfiles } from '../../lib/api';
import { mockupSeo } from '../../lib/seo/mockups';

const profiles = await getProfiles();
const profile = profiles.find((p) => p.code === 'PRD-001');

if (!profile) {
  throw new Error('PRD-001 fixture profile not found for profile-a mockup');
}

const seo = mockupSeo(
  'Profile Detail — Variant A',
  '/mockups/profile-a',
  'Editorial CV profile mockup for PRD-001 — headline, summary, experience timeline.',
);
---

<MockupLayout seo={seo} variantLabel="Profile A — Editorial CV">
  <div class="mockup-page-wrap">
    <ProfileEditorialA profile={profile} />
  </div>
</MockupLayout>
