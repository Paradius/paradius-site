---
import MockupLayout from '../../layouts/MockupLayout.astro';
import MockupPageHero from '../../components/mockups/MockupPageHero.astro';
import FilterBar from '../../components/mockups/FilterBar.astro';
import TalentRowA from '../../components/mockups/TalentRowA.astro';
import { getProfiles } from '../../lib/api';
import { mockupSeo } from '../../lib/seo/mockups';

const profiles = await getProfiles();

const seo = mockupSeo(
  'Talent Catalog — Variant A',
  '/mockups/talent-a',
  'Editorial talent catalog mockup — list rows, generous whitespace, filter bar preview.',
);
---

<MockupLayout seo={seo} variantLabel="Talent A — Editorial">
  <MockupPageHero
    eyebrow="Staff augmentation"
    title="Browse our talent"
    description="Senior nearshore engineers, vetted and ready to present within 48 hours. Pick profiles, assemble your squad — we handle the rest."
  />
  <FilterBar />
  <section class="talent-catalog-a" aria-label="Talent catalog">
    <div class="talent-catalog-a__container">
      {profiles.map((profile) => <TalentRowA profile={profile} />)}
    </div>
    <div class="talent-catalog-a__footer section-reveal">
      <p class="talent-catalog-a__cta-text">Need a full squad assembled?</p>
      <a href="#" class="talent-catalog-a__cta" aria-disabled="true">Build your team</a>
    </div>
  </section>
</MockupLayout>
