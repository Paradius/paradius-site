---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL, type PageSeo } from '../../lib/seo';

const seo: PageSeo = {
  title: 'Type Lab 2, Paradius',
  description: 'Internal specimen lab: candidate type systems judged against the lockup.',
  canonical: `${SITE_URL}/mockups/type-lab-2/`,
  robots: 'noindex, nofollow',
  webPageName: 'Type Lab 2',
  webPageDescription: 'Internal typography direction lab.',
};

/* Round 2. The tuning fork is the lockup: stencil circuit letterforms, geometric,
   angular, technical. Candidates must rhyme with it (share its skeleton) without
   being stencil (closed experiment). Every specimen renders the real lockup on top
   so synergy is judged, not imagined. peakSize compensates very wide faces. */
const DIRECTIONS = [
  {
    id: 'A',
    name: 'El eco del circuito',
    referent: 'La familia cuadrada y tecnica mas cercana al esqueleto del lockup sin ser stencil.',
    melody: "'Chakra Petch', sans-serif",
    voice: "'Saira', sans-serif",
    melodyWeight: 300,
    peakSize: 'clamp(1.7rem, 3.4vw, 2.6rem)',
  },
  {
    id: 'B',
    name: 'El futurista',
    referent: 'Cortes rectos y esquinas achaflanadas, como pistas de circuito dobladas en texto.',
    melody: "'Tomorrow', sans-serif",
    voice: "'Space Grotesk', sans-serif",
    melodyWeight: 300,
    peakSize: 'clamp(1.7rem, 3.4vw, 2.6rem)',
  },
  {
    id: 'C',
    name: 'La pantalla ancha',
    referent: 'Rotulo de consola de nave: ancho, plano, hermano directo del trazo del monolito.',
    melody: "'Michroma', sans-serif",
    voice: "'IBM Plex Sans', sans-serif",
    melodyWeight: 400,
    peakSize: 'clamp(1.25rem, 2.5vw, 1.9rem)',
  },
  {
    id: 'D',
    name: 'El slab tecnico',
    referent: 'Serif de maquina: los remates son vigas, no caligrafia. Calidez sin abandonar la ingenieria.',
    melody: "'Zilla Slab', serif",
    voice: "'Chakra Petch', sans-serif",
    melodyWeight: 300,
    peakSize: 'clamp(1.8rem, 3.6vw, 2.8rem)',
  },
  {
    id: 'E',
    name: 'El militar',
    referent: 'Placa de identificacion de hardware: angulos duros, disciplina, cero adorno.',
    melody: "'Quantico', sans-serif",
    voice: "'Exo 2', sans-serif",
    melodyWeight: 400,
    peakSize: 'clamp(1.6rem, 3.2vw, 2.4rem)',
  },
  {
    id: 'F',
    name: 'Plomeria absoluta',
    referent: 'Una sola familia en tres pesos: nada firma, todo mide. La identidad queda entera en el lockup.',
    melody: "'Space Grotesk', sans-serif",
    voice: "'Space Grotesk', sans-serif",
    melodyWeight: 300,
    peakSize: 'clamp(1.7rem, 3.4vw, 2.6rem)',
  },
  {
    id: 'G',
    name: 'El panel de mando',
    referent: 'Instrumental de cabina: condensada, tecnica, con ritmo vertical de circuito.',
    melody: "'Oxanium', sans-serif",
    voice: "'Rajdhani', sans-serif",
    melodyWeight: 300,
    peakSize: 'clamp(1.8rem, 3.6vw, 2.7rem)',
  },
] as const;

const cleanName = (stack: string) => stack.split(',')[0].replace(/['"]/g, '');
const RENDER = DIRECTIONS.map((d) => ({
  ...d,
  melodyName: cleanName(d.melody),
  voiceName: cleanName(d.voice),
}));

const LAB_FONTS =
  'https://fonts.googleapis.com/css2?' +
  [
    'family=Chakra+Petch:ital,wght@0,300;0,400;0,500;1,300',
    'family=Saira:wght@400;500',
    'family=Tomorrow:ital,wght@0,300;0,400;0,500;1,300',
    'family=Space+Grotesk:wght@300;400;500;700',
    'family=Michroma',
    'family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400',
    'family=Zilla+Slab:ital,wght@0,300;0,400;0,500;1,300',
    'family=Quantico:ital,wght@0,400;0,700;1,400',
    'family=Exo+2:ital,wght@0,300;0,400;0,500;1,300',
    'family=Oxanium:wght@300;400;500',
    'family=Rajdhani:wght@400;500',
  ].join('&') +
  '&display=swap';
---

<BaseLayout seo={seo}>
  <link slot="head" rel="stylesheet" href={LAB_FONTS} />
  <main id="main-content" class="lab">
    <header class="lab__intro">
      <h1>Type Lab 2, ronda 2: sinergia con el monolito</h1>
      <p>
        Regla nueva: cada especimen rinde cuentas ante el lockup, presente arriba de cada
        bloque. Las direcciones salen del ADN formal de ARCHITECTING (geometria, cortes,
        ritmo tecnico), no del catalogo de lujo clasico. Dos familias exactas por bloque;
        lo que varia adentro es peso, caja e italica. Decidi por letra.
      </p>
    </header>

    {
      RENDER.map((d) => (
        <section
          class="dir"
          id={`dir-${d.id}`}
          style={`--melody:${d.melody};--voice:${d.voice};--melody-weight:${d.melodyWeight};--peak-size:${d.peakSize};`}
        >
          <div class="dir__head">
            <span class="dir__letter">{d.id}</span>
            <div>
              <h2 class="dir__name">{d.name}</h2>
              <p class="dir__referent">{d.referent}</p>
              <p class="dir__faces">melodia: {d.melodyName} · voz: {d.voiceName}</p>
            </div>
          </div>

          <div class="spec">
            <span class="tag">el monolito (SVG, intocable): el diapason contra el que se juzga</span>
            <img
              class="spec__lockup"
              src="/assets/architecting_the_dawn_from_within.svg"
              alt="Architecting the Dawn from Within"
              loading="lazy"
            />

            <span class="tag">
              pico: {d.melodyName} {d.melodyWeight} · el enfasis es italica de la misma familia
            </span>
            <p class="spec__peak">
              You can find ten thousand agencies with better rankings, better funding, better
              manners. <em>You will not find one that refuses to quit the way we do.</em>
            </p>

            <div class="spec__thesis">
              <div class="spec__force spec__force--power">
                <span class="tag">label: {d.voiceName} caps · texto: {d.voiceName} 400</span>
                <span class="spec__label">Power</span>
                <p>The architecture, the guardrails, the discipline that keeps systems from rotting.</p>
              </div>
              <div class="spec__force spec__force--will">
                <span class="tag">label: {d.voiceName} caps · texto: {d.melodyName} {d.melodyWeight}</span>
                <span class="spec__label">Will</span>
                <p>The spark. People who cannot leave things worse than they found them.</p>
              </div>
            </div>

            <span class="tag">voz display: {d.voiceName} 400</span>
            <p class="spec__voiceline">
              Then they go remote. And nothing degrades. 0123456789, PRD-001, 48 hours.
            </p>

            <span class="tag">cuerpo: {d.voiceName} 400</span>
            <p class="spec__body">
              We do not hire headcount. We find the ones with the spark and push them further
              than they believed they could go. Every engagement begins in one room: our hub, a
              senior mentor at the next desk, standards enforced from day one.
            </p>

            <span class="tag">hechos: {d.voiceName} 400 · CTAs: {d.voiceName} 500, caps</span>
            <p class="spec__facts">
              Senior nearshore engineering. Managua hub, full US overlap. Paradius LLC, Wyoming.
              US contracts, USD.
            </p>
            <div class="spec__ctas">
              <span class="spec__cta spec__cta--primary">Browse the registry</span>
              <span class="spec__cta">Start your team</span>
            </div>
          </div>
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  .lab {
    background: #000;
    color: #9ca3af;
    padding: 7rem clamp(1.5rem, 5vw, 4rem) 6rem;
  }

  .lab__intro {
    max-width: 46rem;
    margin-bottom: 5rem;
  }

  .lab__intro h1 {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .lab__intro p {
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .dir {
    border-top: 1px solid #1a1a1a;
    padding: 3.5rem 0 4.5rem;
  }

  .dir__head {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    margin-bottom: 3rem;
  }

  .dir__letter {
    font-size: 2.5rem;
    line-height: 1;
    color: #c0c8d4;
    font-weight: 600;
    min-width: 2.5rem;
  }

  .dir__name {
    color: #fff;
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 0.3rem;
  }

  .dir__referent {
    font-size: 0.85rem;
    line-height: 1.6;
    max-width: 40rem;
  }

  .dir__faces {
    font-size: 0.75rem;
    color: #6b7280;
    margin-top: 0.35rem;
  }

  .tag {
    display: block;
    font-family: system-ui, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 0.4rem;
  }

  /* ===== specimen ===== */

  .spec {
    max-width: 62rem;
  }

  .spec__lockup {
    display: block;
    width: min(34rem, 80%);
    margin-bottom: 3rem;
    filter: brightness(0) invert(1);
  }

  .spec__peak {
    font-family: var(--melody);
    font-weight: var(--melody-weight);
    font-size: var(--peak-size);
    line-height: 1.4;
    color: #fff;
    max-width: 58rem;
    margin-bottom: 3rem;
    text-wrap: balance;
  }

  .spec__peak em {
    color: #c0c8d4;
  }

  .spec__thesis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .spec__label {
    display: block;
    font-family: var(--voice);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #c0c8d4;
    margin-bottom: 0.6rem;
  }

  .spec__force--power p {
    font-family: var(--voice);
    font-size: 1rem;
    line-height: 1.7;
  }

  .spec__force--will p {
    font-family: var(--melody);
    font-weight: var(--melody-weight);
    font-size: 1.15rem;
    line-height: 1.6;
    color: #d1d5db;
  }

  .spec__voiceline {
    font-family: var(--voice);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.4;
    color: #e5e7eb;
    margin-bottom: 1.25rem;
  }

  .spec__body {
    font-family: var(--voice);
    font-size: 1rem;
    line-height: 1.75;
    max-width: 42rem;
    margin-bottom: 2.5rem;
  }

  .spec__facts {
    font-family: var(--voice);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
  }

  .spec__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .spec__cta {
    font-family: var(--voice);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.85rem 2.25rem;
    border: 1px solid #c0c8d4;
    color: #c0c8d4;
  }

  .spec__cta--primary {
    background: #fff;
    border-color: #fff;
    color: #000;
  }

  @media (max-width: 700px) {
    .spec__thesis {
      grid-template-columns: 1fr;
    }
  }
</style>
