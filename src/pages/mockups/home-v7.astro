---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL, type PageSeo } from '../../lib/seo';

const seo: PageSeo = {
  title: 'Home v7 Mockup — Paradius',
  description:
    'Internal mockup — invisible spine zigzag, clip-path reveals, full v4 content, inverted scroll ascent.',
  canonical: `${SITE_URL}/mockups/home-v7/`,
  robots: 'noindex, nofollow',
  webPageName: 'Home v7 Mockup',
  webPageDescription: 'Internal design mockup for the Paradius home page v7 redesign.',
};

// Copy source of truth: PRODUCT.md (libreto v3). Left = Power, right = Will,
// center = the unified. Placement is meaning; never mechanical alternation.
---

<BaseLayout seo={seo}>
  <link
    slot="head"
    rel="preload"
    href="/assets/architecting_the_dawn_from_within.svg"
    as="image"
  />
  <!-- TYPE LAB (experiment): two-stencil system — Stardos (voice) + Sirin (body) -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Stardos+Stencil:wght@400;700&family=Sirin+Stencil&display=swap"
  />

  <Header />

  <div class="home-v7">
    <div class="home-v7__tree" data-home-v7-tree aria-hidden="true"></div>

    <main id="main-content" class="home-v7__main">
      <!-- HERO — raíces, centrado -->
      <section class="home-v7__hero" aria-labelledby="hero-heading">
        <div class="home-v7__hero-inner">
          <h1 id="hero-heading" class="sr-only">
            Paradius — Architecting the Dawn from Within | Software Engineering Consultancy
          </h1>
          <img
            class="home-v7__tagline"
            src="/assets/architecting_the_dawn_from_within.svg"
            alt="Paradius: Architecting the Dawn from Within"
            width="288"
            height="97"
            fetchpriority="high"
            decoding="async"
          />
          <div class="home-v7__actions">
            <a href="/talent" class="home-v7__cta">Browse the registry</a>
            <a href="/contact" class="home-v7__cta home-v7__cta--secondary">Start your team</a>
          </div>
        </div>
      </section>

      <!-- NARRATIVE OPENER — first line of the ascent -->
      <section class="home-v7__row" data-home-v7-node id="opener" aria-label="Opening line">
        <div class="home-v7__injerto-wrap">
          <div class="home-v7__clip home-v7__clip--center">
            <p class="home-v7__voice home-v7__voice--center">
              Nobody arrives at Paradius by accident.
            </p>
          </div>
        </div>
      </section>

      <!-- THE CONFESSION — center, a full viewport of its own. Typographic peak 1. -->
      <section
        class="home-v7__row home-v7__row--confession"
        data-home-v7-node
        id="philosophy"
        aria-label="The confession"
      >
        <div class="home-v7__injerto-wrap">
          <div class="home-v7__clip home-v7__clip--center">
            <p class="home-v7__peak">
              You can find ten thousand agencies with better rankings, better funding, better
              manners. <em>You will not find one that refuses to quit the way we do.</em>
            </p>
          </div>
        </div>
      </section>

      <!-- THE THESIS — first fork of the spine. Power falls left, Will falls right. -->
      <section class="home-v7__row" data-home-v7-node id="thesis" aria-label="The thesis">
        <div class="home-v7__injerto-wrap">
          <div class="home-v7__clip home-v7__clip--center">
            <p class="home-v7__voice home-v7__voice--center">
              Before it was a company, Paradius was a story: a world made by two forces.
            </p>
          </div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--split" data-home-v7-node aria-label="Power and Will">
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left">
            <div class="home-v7__content home-v7__clip home-v7__clip--left home-v7__content--depth-2">
              <span class="home-v7__force-label">Power</span>
              <p class="home-v7__power-text">
                The architecture, the guardrails, the discipline that keeps systems from rotting.
              </p>
            </div>
          </div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right home-v7__col--hang">
            <div class="home-v7__content home-v7__clip home-v7__clip--right home-v7__content--depth-1">
              <span class="home-v7__force-label">Will</span>
              <p class="home-v7__voice">
                The spark. People who cannot leave things worse than they found them.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="home-v7__row" data-home-v7-node aria-label="Both forces">
        <div class="home-v7__injerto-wrap">
          <div class="home-v7__clip home-v7__clip--center">
            <p class="home-v7__voice home-v7__voice--center">
              Every system that endures needs both. Most companies sell you one and call it
              engineering.
            </p>
          </div>
        </div>
      </section>

      <!-- THE ENGINE — trunk. Real mechanics, sides per meaning. -->
      <section class="home-v7__row home-v7__row--right" data-home-v7-node id="engine" aria-label="The engine">
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left home-v7__col--empty"></div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right">
            <div class="home-v7__content home-v7__clip home-v7__clip--right home-v7__content--depth-1">
              <p class="home-v7__voice">
                We do not hire headcount. We find the ones with the spark and push them further than
                they believed they could go.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--left home-v7__row--pair" data-home-v7-node>
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left">
            <div class="home-v7__content home-v7__clip home-v7__clip--left home-v7__content--depth-2">
              <article class="home-v7__ops-block">
                <p class="home-v7__ops-text">
                  Every engagement begins in one room: our hub, a senior mentor at the next desk,
                  standards enforced from day one.
                </p>
              </article>
            </div>
          </div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right home-v7__col--empty"></div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--left home-v7__row--pair" data-home-v7-node>
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left">
            <div class="home-v7__content home-v7__clip home-v7__clip--left home-v7__content--depth-3">
              <article class="home-v7__ops-block">
                <p class="home-v7__ops-text">
                  Then they go remote. And nothing degrades, because the discipline travels with
                  them.
                </p>
              </article>
              <a href="/mockups/engine/" class="home-v7__engine-cta">Read the full operating model</a>
            </div>
          </div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right home-v7__col--empty"></div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--right home-v7__row--pair" data-home-v7-node>
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left home-v7__col--empty"></div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right">
            <div class="home-v7__content home-v7__clip home-v7__clip--right home-v7__content--depth-2">
              <p class="home-v7__voice">Nobody here is disposable. Almost nobody leaves.</p>
              <span class="home-v7__sys-note">retention: ~100%</span>
            </div>
          </div>
        </div>
      </section>

      <!-- THE PROOFS — a Will line opens; two fruits in narrated system register. -->
      <section
        class="home-v7__row home-v7__row--right"
        data-home-v7-node
        id="proofs"
        aria-label="The proofs"
      >
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left home-v7__col--empty"></div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right">
            <div class="home-v7__content home-v7__clip home-v7__clip--right home-v7__content--depth-1">
              <p class="home-v7__voice">
                We leave systems better than we found them. Then they stay that way.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--left home-v7__row--pair" data-home-v7-node>
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left">
            <div class="home-v7__content home-v7__clip home-v7__clip--left home-v7__content--depth-2">
              <article class="home-v7__ops-block">
                <h3 class="home-v7__ops-title">Warehouse automation</h3>
                <p class="home-v7__ops-text">
                  We built the visual language that lets robots, inventory and hundreds of services
                  move as one. A Fortune 500 retailer now runs it across its network.
                </p>
              </article>
            </div>
          </div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right home-v7__col--empty"></div>
        </div>
      </section>

      <section class="home-v7__row home-v7__row--left home-v7__row--pair" data-home-v7-node>
        <div class="home-v7__spine">
          <div class="home-v7__col home-v7__col--left">
            <div class="home-v7__content home-v7__clip home-v7__clip--left home-v7__content--depth-3">
              <article class="home-v7__ops-block">
                <h3 class="home-v7__ops-title">Banking infrastructure</h3>
                <p class="home-v7__ops-text">
                  Payments stopped going missing. Delays became guarantees. Those systems are still
                  standing, years later, untouched by us.
                </p>
              </article>
            </div>
          </div>
          <div class="home-v7__axis" aria-hidden="true"></div>
          <div class="home-v7__col home-v7__col--right home-v7__col--empty"></div>
        </div>
      </section>

      <!-- THE CANOPY — the dawn. Both forces merge at center. Typographic peak 2. -->
      <section
        class="home-v7__row home-v7__row--dawn"
        data-home-v7-node
        id="assurance"
        aria-label="The dawn"
      >
        <div class="home-v7__injerto-wrap">
          <div class="home-v7__clip home-v7__clip--center">
            <div class="home-v7__dawn">
              <p class="home-v7__peak">The dawn is not ours. It is yours.</p>
              <p class="home-v7__dawn-text">
                Our engineers carry codes instead of names. Your systems carry no signature of ours.
                We build the morning; you keep it. That is the whole story of Paradius, and it ends
                the same way every time: we disappear into your success.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- COPA — registry left (Power: the codes), work right (Will: what was achieved) -->
      <section class="home-v7__row home-v7__row--cup" data-home-v7-cup>
        <div class="home-v7__cup-grid">
          <article
            class="home-v7__cup-col home-v7__cup-col--registry home-v7__clip home-v7__clip--left"
            id="talent-teaser"
            aria-labelledby="talent-teaser-heading"
          >
            <h2 class="home-v7__title home-v7__title--sm" id="talent-teaser-heading">
              The registry
            </h2>
            <p class="home-v7__text">
              Senior engineers under code names: review, filter, request. Presented within 48
              hours.
            </p>
            <a href="/talent" class="home-v7__teaser-cta">Browse the registry</a>
          </article>

          <article
            class="home-v7__cup-col home-v7__clip home-v7__clip--right"
            id="work-teaser"
            aria-labelledby="work-teaser-heading"
          >
            <h2 class="home-v7__title home-v7__title--sm" id="work-teaser-heading">
              The work
            </h2>
            <p class="home-v7__text">
              What we built and left standing. Anonymized, like everything we do.
            </p>
            <a href="/work" class="home-v7__teaser-cta">View case studies</a>
          </article>
        </div>
      </section>
    </main>
  </div>

  <Footer />
  <script src="../../scripts/home-v7.ts"></script>
</BaseLayout>

<style>
  :global(body:has(.home-v7))::before {
    opacity: 0 !important;
  }

  :global(body:has(.home-v7) .site-header) {
    background-color: rgb(0 0 0 / 0.82);
  }

  /* ── TYPE LAB — two-stencil system (tecla 2 / ?type=s):
     Stardos Stencil = voice (the Cormorant role) · Sirin Stencil = melodic body ── */
  .home-v7[data-typelab='s'] {
    --font-heading: 'Stardos Stencil', 'Cormorant Garamond', serif;
  }

  .home-v7[data-typelab='s'] .home-v7__main {
    font-family: 'Sirin Stencil', 'Inter', sans-serif;
  }

  .home-v7[data-typelab='s'] .home-v7__force-label {
    font-family: 'Stardos Stencil', serif;
    font-weight: 700;
  }

  .home-v7[data-typelab='s'] .home-v7__peak em {
    font-style: normal;
    color: var(--color-accent);
  }

  .home-v7 {
    position: relative;
    isolation: isolate;
  }

  .home-v7__tree {
    position: fixed;
    top: 0;
    left: 50%;
    z-index: 0;
    width: min(96vw, 88rem);
    height: 220dvh;
    pointer-events: none;
    transform: translateX(-50%) translateY(-50vh);
    opacity: 0.04;
    background-color: #fff;
    -webkit-mask-image: url('/assets/circuit_tree_full.svg');
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center top;
    -webkit-mask-size: 100% 100%;
    mask-image: url('/assets/circuit_tree_full.svg');
    mask-repeat: no-repeat;
    mask-position: center top;
    mask-size: 100% 100%;
    will-change: transform, opacity;
  }

  .home-v7__main {
    position: relative;
    z-index: 1;
    overflow-x: hidden;
  }

  /* Spine grid — full bleed, gutters scale with viewport */
  .home-v7__spine {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(2.5rem, 4.5vw, 5rem) minmax(0, 1fr);
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: clamp(1rem, 5vw, 5rem);
    align-items: start;
  }

  .home-v7__axis {
    /* empty — perception only */
  }

  .home-v7__col--left {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .home-v7__col--right {
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Branch depth — each block starts at a different distance from spine / edge */
  .home-v7__content {
    width: min(100%, var(--content-span, 46ch));
    max-width: none;
  }

  .home-v7__col--left .home-v7__content {
    padding-inline-end: var(--branch-gap, clamp(0.5rem, 2vw, 2rem));
    margin-inline-start: var(--branch-push, 0);
  }

  .home-v7__col--right .home-v7__content {
    padding-inline-start: var(--branch-gap, clamp(0.5rem, 2vw, 2rem));
    margin-inline-end: var(--branch-push, 0);
  }

  .home-v7__content--depth-1 {
    --branch-push: clamp(0rem, 2vw, 1.5rem);
    --branch-gap: clamp(0.75rem, 2.5vw, 2.5rem);
    --content-span: 44ch;
  }

  .home-v7__content--depth-2 {
    --branch-push: clamp(1rem, 7vw, 6rem);
    --branch-gap: clamp(0.5rem, 1.5vw, 1.25rem);
    --content-span: 40ch;
  }

  .home-v7__content--depth-3 {
    --branch-push: clamp(0.25rem, 4.5vw, 3.5rem);
    --branch-gap: clamp(1.25rem, 3.5vw, 3rem);
    --content-span: 50ch;
  }

  /* Dual-branch row */
  .home-v7__row--split {
    margin-block: clamp(1.25rem, 2.5vh, 2rem);
  }

  .home-v7__row--split .home-v7__col--left {
    align-self: start;
    padding-top: 0;
  }

  .home-v7__row--split .home-v7__col--hang {
    align-self: start;
    padding-top: clamp(0.75rem, 2.5vh, 1.5rem);
  }

  .home-v7__row--split .home-v7__content--depth-2 {
    --branch-push: clamp(1.5rem, 9vw, 8rem);
  }

  .home-v7__row--split .home-v7__content--depth-1 {
    --branch-push: clamp(0rem, 3vw, 2rem);
    --content-span: 46ch;
  }

  /* Row rhythm — sparse libreto: every line earns its air, and consecutive
     same-side rows need clearance for the 0.55vh settle pull-down. */
  .home-v7__row {
    margin-block: clamp(4rem, 12vh, 9rem);
    scroll-margin-top: calc(var(--site-header-height) + 1.5rem);
  }

  .home-v7__hero + .home-v7__row {
    margin-block-start: clamp(0.5rem, 1.25vh, 1rem);
  }

  .home-v7__row--pair {
    margin-block-start: clamp(2.5rem, 8vh, 6rem);
  }

  .home-v7__row--cup {
    margin-bottom: clamp(8rem, 18vh, 14rem);
  }

  /* Hero */
  .home-v7__hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    box-sizing: border-box;
    padding-top: var(--site-header-height);
    padding-bottom: clamp(0.75rem, 2vh, 1.5rem);
    margin-block: 0;
  }

  .home-v7__hero-inner {
    text-align: center;
    max-width: 1500px;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .home-v7__tagline {
    display: block;
    width: 44vw;
    max-width: 880px;
    height: auto;
    margin-inline: auto;
    margin-bottom: var(--spacing-lg);
    opacity: 0;
    transform: translateY(1.5rem);
    filter: brightness(0) invert(1);
    -webkit-mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 78%);
    -webkit-mask-size: 100% 300%;
    -webkit-mask-position: 0% 0%;
    mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 78%);
    mask-size: 100% 300%;
    mask-position: 0% 0%;
    animation: home-v7-dawn-rise 1.4s var(--ease-brand) 0.15s both;
  }

  @keyframes home-v7-dawn-rise {
    0% {
      opacity: 0;
      transform: translateY(1.5rem);
      mask-position: 0% 0%;
      -webkit-mask-position: 0% 0%;
      filter: brightness(0) invert(0.35) drop-shadow(0 0 0 rgb(214 206 188 / 0));
    }

    55% {
      opacity: 1;
      filter: brightness(0) invert(1) drop-shadow(0 0 34px rgb(214 206 188 / 0.3));
    }

    100% {
      opacity: 1;
      transform: translateY(0);
      mask-position: 0% 100%;
      -webkit-mask-position: 0% 100%;
      filter: brightness(0) invert(1) drop-shadow(0 0 18px rgb(200 208 220 / 0.14));
    }
  }

  .home-v7__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    justify-content: center;
    opacity: 0;
    transform: translateY(0.75rem);
    animation: home-v7-quiet-rise 0.7s var(--ease-brand) 0.75s both;
  }

  @keyframes home-v7-quiet-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .home-v7__cta {
    display: inline-block;
    padding: 0.875rem 2.5rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-bg);
    background-color: var(--color-text-primary);
    border: 1px solid var(--color-text-primary);
    text-decoration: none;
    transition:
      background-color var(--transition-duration-base) ease,
      color var(--transition-duration-base) ease,
      transform var(--transition-duration-fast) ease;
  }

  .home-v7__cta:hover,
  .home-v7__cta:focus-visible {
    background-color: transparent;
    color: var(--color-text-primary);
    transform: translateY(-1px);
  }

  .home-v7__cta--secondary {
    color: var(--color-text-primary);
    background-color: transparent;
  }

  .home-v7__cta--secondary:hover,
  .home-v7__cta--secondary:focus-visible {
    background-color: var(--color-text-primary);
    color: var(--color-bg);
  }

  /* Typography */
  .home-v7__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-heading);
    margin: 0 0 var(--spacing-md);
    line-height: 1.15;
  }

  .home-v7__title--sm {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .home-v7__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .home-v7__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Operation-style blocks (Power statements, proofs) */
  .home-v7__ops-block + .home-v7__ops-block {
    margin-top: var(--spacing-lg);
  }

  .home-v7__row--left .home-v7__ops-block {
    text-align: right;
    border-right: 2px solid var(--color-accent);
    padding-right: var(--spacing-md);
  }

  .home-v7__row--right .home-v7__ops-block {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--spacing-md);
  }

  .home-v7__ops-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-system);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--spacing-xs);
  }

  .home-v7__ops-text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }

