---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL, type PageSeo } from '../../lib/seo';

const seo: PageSeo = {
  title: 'Home v4 Mockup — Paradius',
  description:
    'Internal mockup — inverted scroll ascent, dense station flow, distributed software engine narrative.',
  canonical: `${SITE_URL}/mockups/home-v4/`,
  robots: 'noindex, nofollow',
  webPageName: 'Home v4 Mockup',
  webPageDescription: 'Internal design mockup for the Paradius home page v4 redesign.',
};

const enginePillars = [
  {
    label: 'Surgical recruitment',
    mono: 'sniping pipeline · network nodes · deep profile evaluation',
    text: 'A curated recruitment pipeline targeting high-caliber talent through direct network nodes, rigorous references, and evaluations aligned with our core ethos — never headcount, always density.',
  },
  {
    label: 'Distributed operating model',
    mono: 'hub immersion · senior mentor · zero-latency sync',
    text: 'High-redundancy, distributed architecture — not a static nucleus. Physical immersion at our office hub, paired with a senior mentor, then transition to fully remote without loss in throughput.',
  },
  {
    label: 'Guardrails & observability',
    mono: 'automated guardrails · drift correction · executive metrics',
    text: 'Proprietary AI-accelerated development plugin enforcing automated guardrails over every line shipped, with delivery observability and precise operational metrics for executive leadership.',
  },
  {
    label: 'Built to scale',
    mono: 'US-nearshore · B2B frameworks · R&D bench',
    text: 'Supported by standard US-nearshore rate structures, ironclad B2B legal frameworks, and a dynamic internal R&D ecosystem — ready to scale execution capacity on demand.',
  },
] as const;

const selectionSteps = [
  {
    title: 'Sniping pipeline',
    description:
      'Direct network nodes, rigorous references, and deep profile evaluations that match our core ethos. We target high-caliber talent surgically — not through volume screening.',
  },
  {
    title: 'Stress-testing',
    description:
      'Comprehensive technical and behavioral stress-testing that surfaces how engineers think under pressure, communicate trade-offs, and hold the line on quality.',
  },
  {
    title: 'CEO synchronization',
    description:
      'A direct synchronization with our CEO to ensure total alignment with what it means to build under the Paradius banner — architectural excellence as a shared standard.',
  },
] as const;

const operationBlocks = [
  {
    title: 'Hub immersion',
    text: 'Every engagement begins with complete physical immersion at our office hub, paired directly with a senior mentor who enforces rigorous quality standards from day one.',
  },
  {
    title: 'Zero-latency environment',
    text: 'Daily face-to-face communication establishes operational transparency and high fault tolerance — blockers eliminated in real time, context shared as a collective mental processor.',
  },
  {
    title: 'Remote without drift',
    text: 'Once channels are fully established, developers transition to fully remote with no loss in throughput — the synchronization hardwired into our proprietary development plugin.',
  },
  {
    title: 'Context redundancy',
    text: 'Mentorship distributes context across multiple team members, eliminating single points of failure and enabling zero-friction transitions when scaling talent.',
  },
] as const;

const assuranceMetrics = [
  '~100% developer retention',
  'US-nearshore rate structures',
  'Ironclad B2B frameworks',
  'Internal R&D bench, warm and evolving',
  'Scale on demand',
] as const;
---

<BaseLayout seo={seo}>
  <link
    slot="head"
    rel="preload"
    href="/assets/architecting_the_dawn_from_within.svg"
    as="image"
  />

  <Header />

  <div class="home-v4">
    <div class="home-v4__tree" data-home-v4-tree aria-hidden="true"></div>

    <main id="main-content" class="home-v4__main">
      <!-- Hero -->
      <section class="home-v4__hero" aria-labelledby="hero-heading">
        <div class="home-v4__hero-inner">
          <h1 id="hero-heading" class="sr-only">
            Paradius — Architecting the Dawn from Within | Software Engineering Consultancy
          </h1>
          <img
            class="home-v4__tagline"
            src="/assets/architecting_the_dawn_from_within.svg"
            alt="Paradius: Architecting the Dawn from Within"
            width="288"
            height="97"
            fetchpriority="high"
            decoding="async"
          />
          <p class="home-v4__subtitle">
            Curated talent drafting the future's blueprint
          </p>
          <div class="home-v4__actions">
            <a href="/talent" class="home-v4__cta">Browse the registry</a>
            <a href="/contact" class="home-v4__cta home-v4__cta--secondary">Start your team</a>
          </div>
        </div>
      </section>

      <!-- 01 — CONVICTION -->
      <section
        class="home-v4__section home-v4__section--conviction"
        data-home-v4-section
        id="philosophy"
        aria-labelledby="philosophy-heading"
      >
        <div class="home-v4__container">
          <p class="home-v4__eyebrow home-v4__reveal" style="--reveal-i: 0">01 — CONVICTION</p>
          <h2 class="home-v4__title home-v4__reveal" id="philosophy-heading" style="--reveal-i: 1">
            Architecture Begins With People
          </h2>
          <div class="home-v4__conviction-grid">
            <p class="home-v4__text home-v4__reveal" style="--reveal-i: 2">
              Great engineering doesn't come from process or tooling — it comes from people with the
              spark, who see systems as they should be and commit to building that future. Paradius
              curates talent with the will to build things that last: engineers who think in
              architecture, choose discipline over convenience, and bring structure, direction, and
              momentum to every engagement.
            </p>
            <blockquote class="home-v4__quote home-v4__reveal" style="--reveal-i: 3">
              <p>
                For engineers: a place where your spark is an asset, not a liability. For companies:
                architecture-first teams driven by will, not inertia — reducing risk, accelerating
                delivery, and creating systems that endure.
              </p>
            </blockquote>
          </div>
        </div>
      </section>

      <!-- 02 — THE ENGINE ★ -->
      <section
        class="home-v4__section home-v4__section--engine"
        data-home-v4-section
        id="engine"
        aria-labelledby="engine-heading"
      >
        <div class="home-v4__container home-v4__container--wide">
          <p class="home-v4__eyebrow home-v4__reveal" style="--reveal-i: 0">02 — THE ENGINE</p>
          <h2 class="home-v4__title home-v4__title--engine home-v4__reveal" id="engine-heading" style="--reveal-i: 1">
            Not a monolithic staffing agency. A high-throughput, distributed software engine engineered
            for absolute architectural excellence.
          </h2>
          <div class="home-v4__pillars">
            {
              enginePillars.map((pillar, index) => (
                <article class="home-v4__pillar home-v4__reveal" style={`--reveal-i: ${index + 2}`}>
                  <h3 class="home-v4__pillar-label">{pillar.label}</h3>
                  <p class="home-v4__pillar-mono">{pillar.mono}</p>
                  <p class="home-v4__pillar-text">{pillar.text}</p>
                </article>
              ))
            }
          </div>
          <a href="/mockups/engine/" class="home-v4__engine-cta home-v4__reveal" style="--reveal-i: 6">
            Read the full operating model
          </a>
        </div>
      </section>

      <!-- 03 — SELECTION -->
      <section
        class="home-v4__section home-v4__section--selection"
        data-home-v4-section
        id="selection"
        aria-labelledby="selection-heading"
      >
        <div class="home-v4__container">
          <p class="home-v4__eyebrow home-v4__reveal" style="--reveal-i: 0">03 — SELECTION</p>
          <h2 class="home-v4__title home-v4__reveal" id="selection-heading" style="--reveal-i: 1">
            How we select
          </h2>
          <ol class="home-v4__steps">
            {
              selectionSteps.map((step, index) => (
                <li class="home-v4__step home-v4__reveal" style={`--reveal-i: ${index + 2}`}>
                  <span class="home-v4__step-num">0{index + 1}</span>
                  <h3 class="home-v4__step-title">{step.title}</h3>
                  <p class="home-v4__step-desc">{step.description}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- 04 — OPERATION -->
      <section
        class="home-v4__section home-v4__section--operation"
        data-home-v4-section
        id="operation"
        aria-labelledby="operation-heading"
      >
        <div class="home-v4__container">
          <p class="home-v4__eyebrow home-v4__reveal" style="--reveal-i: 0">04 — OPERATION</p>
          <h2 class="home-v4__title home-v4__reveal" id="operation-heading" style="--reveal-i: 1">
            How we operate
          </h2>
          <div class="home-v4__ops-grid">
            {
              operationBlocks.map((block, index) => (
                <article class="home-v4__ops-block home-v4__reveal" style={`--reveal-i: ${index + 2}`}>
                  <h3 class="home-v4__ops-title">{block.title}</h3>
                  <p class="home-v4__ops-text">{block.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 05 — ASSURANCE -->
      <section
        class="home-v4__section home-v4__section--assurance"
        data-home-v4-section
        id="assurance"
        aria-labelledby="assurance-heading"
      >
        <div class="home-v4__container">
          <p class="home-v4__eyebrow home-v4__reveal" style="--reveal-i: 0">05 — ASSURANCE</p>
          <h2 class="home-v4__title home-v4__sr-section-title" id="assurance-heading">
            Assurance metrics
          </h2>
          <div class="home-v4__assurance-strip home-v4__reveal" style="--reveal-i: 1">
            {
              assuranceMetrics.map((metric, index) => (
                <>
                  {index > 0 && <span class="home-v4__assurance-sep" aria-hidden="true" />}
                  <span class="home-v4__assurance-metric">{metric}</span>
                </>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 06 + 07 — EVIDENCE & REGISTRY (copa) -->
      <section class="home-v4__section home-v4__section--cup" data-home-v4-section>
        <div class="home-v4__container">
          <div class="home-v4__cup-grid">
            <article
              class="home-v4__cup-col home-v4__cup-col--evidence home-v4__reveal"
              id="work-teaser"
              style="--reveal-i: 0"
              aria-labelledby="work-teaser-heading"
            >
              <p class="home-v4__eyebrow">06 — EVIDENCE</p>
              <h2 class="home-v4__title home-v4__title--sm" id="work-teaser-heading">See our work</h2>
              <p class="home-v4__text">
                Architecture-first engagements for enterprise teams — anonymized case studies that show
                how we design, build, and leave systems better than we found them.
              </p>
              <a href="/work" class="home-v4__teaser-cta">View case studies</a>
            </article>

            <article
              class="home-v4__cup-col home-v4__cup-col--registry home-v4__reveal"
              id="talent-teaser"
              style="--reveal-i: 2"
              aria-labelledby="talent-teaser-heading"
            >
              <p class="home-v4__eyebrow">07 — REGISTRY</p>
              <h2 class="home-v4__title home-v4__title--sm" id="talent-teaser-heading">
                Browse our talent
              </h2>
              <p class="home-v4__text">
                Senior engineers across architecture, mobile, and back-end — anonymized profiles you
                can review, filter, and request within 48 hours.
              </p>
              <a href="/talent" class="home-v4__teaser-cta">Explore the catalog</a>
            </article>
          </div>
        </div>
      </section>
    </main>
  </div>

  <Footer />
  <script src="../../scripts/home-v4.ts"></script>
</BaseLayout>

<style>
  :global(body:has(.home-v4))::before {
    opacity: 0 !important;
  }

  :global(body:has(.home-v4) .site-header) {
    background-color: rgb(0 0 0 / 0.82);
  }

  .home-v4 {
    position: relative;
    isolation: isolate;
  }

  .home-v4__tree {
    position: fixed;
    top: 0;
    left: 50%;
    z-index: 0;
    width: min(92vw, 72rem);
    height: 200dvh;
    pointer-events: none;
    transform: translateX(-50%) translateY(-50vh);
    opacity: 0.04;
    background-color: #fff;
    -webkit-mask-image: url('/assets/circuit_tree_full.svg');
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center center;
    -webkit-mask-size: 100% 100%;
    mask-image: url('/assets/circuit_tree_full.svg');
    mask-repeat: no-repeat;
    mask-position: center center;
    mask-size: 100% 100%;
    will-change: transform, opacity;
  }

  .home-v4__main {
    position: relative;
    z-index: 1;
  }

  /* Hero */
  .home-v4__hero {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-height: 100dvh;
    padding-top: calc(var(--site-header-height) + clamp(4rem, 12vh, 7rem));
    padding-bottom: clamp(2rem, 5vh, 3rem);
    box-sizing: border-box;
  }

  .home-v4__hero-inner {
    text-align: center;
    max-width: 1500px;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .home-v4__tagline {
    display: block;
    width: 44vw;
    max-width: 880px;
    height: auto;
    margin-inline: auto;
    margin-bottom: var(--spacing-lg);
    opacity: 0;
    transform: translateY(1.5rem);
    filter: brightness(0) invert(1);
    -webkit-mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 78%);
    -webkit-mask-size: 100% 300%;
    -webkit-mask-position: 0% 0%;
    mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 78%);
    mask-size: 100% 300%;
    mask-position: 0% 0%;
    animation: home-v4-dawn-rise 2.2s var(--ease-brand) 0.3s both;
  }

  @keyframes home-v4-dawn-rise {
    0% {
      opacity: 0;
      transform: translateY(1.5rem);
      mask-position: 0% 0%;
      -webkit-mask-position: 0% 0%;
      filter: brightness(0) invert(0.35) drop-shadow(0 0 0 rgb(214 206 188 / 0));
    }

    55% {
      opacity: 1;
      filter: brightness(0) invert(1) drop-shadow(0 0 34px rgb(214 206 188 / 0.3));
    }

    100% {
      opacity: 1;
      transform: translateY(0);
      mask-position: 0% 100%;
      -webkit-mask-position: 0% 100%;
      filter: brightness(0) invert(1) drop-shadow(0 0 18px rgb(200 208 220 / 0.14));
    }
  }

  .home-v4__subtitle {
    font-family: var(--font-brand);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 500;
    font-style: italic;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xl);
    letter-spacing: var(--tracking-subtitle);
    line-height: 1.6;
    opacity: 0;
    transform: translateY(0.75rem);
    animation: home-v4-quiet-rise 1.2s var(--ease-brand) 1.5s both;
  }

  .home-v4__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    justify-content: center;
    opacity: 0;
    transform: translateY(0.75rem);
    animation: home-v4-quiet-rise 1.2s var(--ease-brand) 1.85s both;
  }

  @keyframes home-v4-quiet-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .home-v4__cta {
    display: inline-block;
    padding: 0.875rem 2.5rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-bg);
    background-color: var(--color-text-primary);
    border: 1px solid var(--color-text-primary);
    text-decoration: none;
    transition:
      background-color var(--transition-duration-base) ease,
      color var(--transition-duration-base) ease,
      transform var(--transition-duration-fast) ease;
  }

  .home-v4__cta:hover,
  .home-v4__cta:focus-visible {
    background-color: transparent;
    color: var(--color-text-primary);
    transform: translateY(-1px);
  }

  .home-v4__cta--secondary {
    color: var(--color-text-primary);
    background-color: transparent;
  }

  .home-v4__cta--secondary:hover,
  .home-v4__cta--secondary:focus-visible {
    background-color: var(--color-text-primary);
    color: var(--color-bg);
  }

  /* Sections — dense vertical rhythm */
  .home-v4__section {
    position: relative;
    padding-block: 0;
    margin-top: clamp(5rem, 7vw, 8rem);
    scroll-margin-top: calc(var(--site-header-height) + 1.5rem);
  }

  .home-v4__section--conviction {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .home-v4__section--cup {
    margin-bottom: clamp(6rem, 8vw, 10rem);
  }

  .home-v4__container {
    max-width: var(--width-content-wide);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .home-v4__container--wide {
    max-width: min(90rem, 100%);
  }

  .home-v4__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-system);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--spacing-sm);
  }

  .home-v4__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-heading);
    margin: 0 0 var(--spacing-md);
    line-height: 1.15;
  }

  .home-v4__title--sm {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .home-v4__title--engine {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    max-width: 52rem;
    line-height: 1.2;
    margin-bottom: var(--spacing-lg);
  }

  .home-v4__sr-section-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .home-v4__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Conviction */
  .home-v4__conviction-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: start;
  }

  .home-v4__quote {
    position: relative;
    padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-md);
    margin: 0;
    border: none;
    background: transparent;
  }

  .home-v4__quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-top: 2px solid var(--color-accent);
    border-left: 2px solid var(--color-accent);
    pointer-events: none;
  }

  .home-v4__quote p {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-accent);
    margin: 0;
  }

  /* Engine ★ */
  .home-v4__section--engine {
    padding-block: var(--spacing-lg);
    border-block: 1px solid var(--color-divider);
    background: linear-gradient(
      180deg,
      rgb(192 200 212 / 0.03) 0%,
      transparent 40%,
      transparent 60%,
      rgb(192 200 212 / 0.02) 100%
    );
  }

  .home-v4__pillars {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .home-v4__pillar {
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: var(--color-surface);
    border: 1px solid var(--color-divider);
  }

  .home-v4__pillar-label {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-xs);
    letter-spacing: var(--tracking-card-title);
  }

  .home-v4__pillar-mono {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-system);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--spacing-sm);
    line-height: 1.5;
  }

  .home-v4__pillar-text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .home-v4__engine-cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-system);
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.125rem;
    transition: opacity var(--transition-duration-base) ease;
  }

  .home-v4__engine-cta:hover,
  .home-v4__engine-cta:focus-visible {
    opacity: 0.75;
  }

  /* Selection */
  .home-v4__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .home-v4__step {
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: var(--color-surface);
    border: 1px solid var(--color-divider);
  }

  .home-v4__step-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-system);
    color: var(--color-accent);
    margin-bottom: var(--spacing-xs);
  }

  .home-v4__step-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-sm);
  }

  .home-v4__step-desc {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Operation */
  .home-v4__ops-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .home-v4__ops-block {
    padding: var(--spacing-md);
    border-left: 2px solid var(--color-accent);
  }

  .home-v4__ops-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-system);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--spacing-xs);
  }

  .home-v4__ops-text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
