---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL, type PageSeo } from '../../lib/seo';

const seo: PageSeo = {
  title: 'Home v5 Mockup — Paradius',
  description:
    'Internal mockup — The Invisible Spine: inverted ascent, zigzag nodes, SVG branch reveals.',
  canonical: `${SITE_URL}/mockups/home-v5/`,
  robots: 'noindex, nofollow',
  webPageName: 'Home v5 Mockup',
  webPageDescription: 'Internal design mockup for the Paradius home page v5 — invisible spine layout.',
};
---

<BaseLayout seo={seo}>
  <link
    slot="head"
    rel="preload"
    href="/assets/architecting_the_dawn_from_within.svg"
    as="image"
  />

  <Header />

  <div class="home-v5">
    <svg class="home-v5__branches" data-home-v5-branches aria-hidden="true"></svg>

    <main id="main-content" class="home-v5__main">
      <!-- [CENTRO] HERO — Raíces (DOM bottom / visual roots) -->
      <section class="home-v5__hero" aria-labelledby="hero-heading">
        <div class="home-v5__hero-inner">
          <h1 id="hero-heading" class="sr-only">
            Paradius — Architecting the Dawn from Within | Software Engineering Consultancy
          </h1>
          <img
            class="home-v5__tagline"
            src="/assets/architecting_the_dawn_from_within.svg"
            alt="Paradius: Architecting the Dawn from Within"
            width="288"
            height="97"
            fetchpriority="high"
            decoding="async"
          />
          <p class="home-v5__subtitle">Curated talent drafting the future's blueprint</p>
          <div class="home-v5__actions">
            <a href="/talent" class="home-v5__cta">Browse the registry</a>
            <a href="/contact" class="home-v5__cta home-v5__cta--secondary">Start your team</a>
          </div>
        </div>
      </section>

      <!-- [IZQUIERDA] 01 CONVICTION -->
      <section
        class="home-v5__node home-v5__node--left"
        data-home-v5-node
        id="conviction"
        aria-labelledby="conviction-heading"
      >
        <div class="home-v5__node-inner">
          <p class="home-v5__eyebrow">01 — CONVICTION</p>
          <h2 class="home-v5__title" id="conviction-heading">Architecture begins with people.</h2>
          <p class="home-v5__text">
            Great engineering doesn't come from process or tooling — it comes from people with the
            spark, who see systems as they should be and commit to building that future. Paradius
            curates talent with the will to build things that last.
          </p>
        </div>
      </section>

      <!-- [DERECHA] 01 CITA -->
      <section class="home-v5__node home-v5__node--right" data-home-v5-node aria-label="Conviction quote">
        <div class="home-v5__node-inner">
          <p class="home-v5__eyebrow">01 — CITA</p>
          <blockquote class="home-v5__quote">
            <p>
              For engineers: a place where your spark is an asset, not a liability. For companies:
              architecture-first teams driven by will, not inertia — reducing risk, accelerating
              delivery, and creating systems that endure.
            </p>
          </blockquote>
        </div>
      </section>

      <!-- [IZQUIERDA] 02 THE ENGINE -->
      <section
        class="home-v5__node home-v5__node--left"
        data-home-v5-node
        id="engine"
        aria-labelledby="engine-heading"
      >
        <div class="home-v5__node-inner">
          <p class="home-v5__eyebrow">02 — THE ENGINE</p>
          <h2 class="home-v5__title" id="engine-heading">
            Not a staffing agency. A distributed software engine.
          </h2>
        </div>
      </section>

      <!-- [DERECHA] 02 NODE A — ACQUISITION -->
      <section
        class="home-v5__node home-v5__node--right"
        data-home-v5-node
        aria-labelledby="acquisition-heading"
      >
        <div class="home-v5__node-inner">
          <p class="home-v5__eyebrow">02 — NODE A</p>
          <h3 class="home-v5__node-label" id="acquisition-heading">Acquisition</h3>
          <p class="home-v5__text">
            Surgical sniping pipeline. Direct network nodes &amp; stress-testing.
          </p>
        </div>
      </section>

      <!-- [IZQUIERDA] 02 NODE B — OPERATION -->
      <section
        class="home-v5__node home-v5__node--left"
        data-home-v5-node
        aria-labelledby="operation-heading"
      >
        <div class="home-v5__node-inner">
          <p class="home-v5__eyebrow">02 — NODE B</p>
          <h3 class="home-v5__node-label" id="operation-heading">Operation</h3>
          <p class="home-v5__text">
            Zero-latency physical immersion &amp; senior mentorship.
          </p>
        </div>
      </section>

      <!-- [DERECHA] 02 NODE C — GUARDRAILS -->
      <section
        class="home-v5__node home-v5__node--right"
        data-home-v5-node
        aria-labelledby="guardrails-heading"
      >
        <div class="home-v5__node-inner">
          <p class="home-v5__eyebrow">02 — NODE C</p>
          <h3 class="home-v5__node-label" id="guardrails-heading">Guardrails</h3>
          <p class="home-v5__text">
            AI-accelerated plugins &amp; real-time drift correction.
          </p>
        </div>
      </section>

      <!-- [IZQUIERDA] 03 ASSURANCE -->
      <section
        class="home-v5__node home-v5__node--left"
        data-home-v5-node
        id="assurance"
        aria-labelledby="assurance-heading"
      >
        <div class="home-v5__node-inner">
          <p class="home-v5__eyebrow">03 — ASSURANCE</p>
          <h2 class="home-v5__title home-v5__sr-only" id="assurance-heading">Assurance</h2>
          <p class="home-v5__assurance">
            ~100% retention. US-nearshore rates. B2B frameworks.
          </p>
        </div>
      </section>

      <!-- [COPA] 04 EVIDENCE & 05 REGISTRY -->
      <section class="home-v5__cup" data-home-v5-node data-home-v5-cup>
        <div class="home-v5__cup-grid">
          <article
            class="home-v5__cup-col home-v5__cup-col--evidence"
            id="work-teaser"
            aria-labelledby="work-teaser-heading"
          >
            <p class="home-v5__eyebrow">04 — EVIDENCE</p>
            <h2 class="home-v5__title home-v5__title--sm" id="work-teaser-heading">See our work</h2>
            <p class="home-v5__text">
              Architecture-first engagements for enterprise teams — anonymized case studies that show
              how we design, build, and leave systems better than we found them.
            </p>
            <a href="/work" class="home-v5__teaser-cta">View case studies</a>
          </article>

          <article
            class="home-v5__cup-col home-v5__cup-col--registry"
            id="talent-teaser"
            aria-labelledby="talent-teaser-heading"
          >
            <p class="home-v5__eyebrow">05 — REGISTRY</p>
            <h2 class="home-v5__title home-v5__title--sm" id="talent-teaser-heading">
              Browse our talent
            </h2>
            <p class="home-v5__text">
              Senior engineers across architecture, mobile, and back-end — anonymized profiles you
              can review, filter, and request within 48 hours.
            </p>
            <a href="/talent" class="home-v5__teaser-cta">Explore the catalog</a>
          </article>
        </div>
      </section>
    </main>
  </div>

  <Footer />
  <script src="../../scripts/home-v5.ts"></script>
</BaseLayout>

<style>
  :global(body:has(.home-v5))::before {
    opacity: 0 !important;
  }

  :global(body:has(.home-v5) .site-header) {
    background-color: rgb(0 0 0 / 0.82);
  }

  .home-v5 {
    position: relative;
    isolation: isolate;
  }

  .home-v5__branches {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .home-v5__main {
    position: relative;
    z-index: 1;
  }

  /* Invisible spine axis — no trunk drawn */
  .home-v5__node {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: clamp(8rem, 14vh, 12rem);
    padding-inline: var(--spacing-gutter);
    scroll-margin-top: calc(var(--site-header-height) + 1.5rem);
  }

  .home-v5__node--left .home-v5__node-inner {
    grid-column: 1;
    justify-self: end;
    text-align: right;
    max-width: min(38rem, 44vw);
    padding-right: clamp(1.5rem, 3vw, 3rem);
  }

  .home-v5__node--right .home-v5__node-inner {
    grid-column: 2;
    justify-self: start;
    text-align: left;
    max-width: min(38rem, 44vw);
    padding-left: clamp(1.5rem, 3vw, 3rem);
  }

  /* Hero — centered on invisible spine */
  .home-v5__hero {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-height: 100dvh;
    padding-top: calc(var(--site-header-height) + clamp(4rem, 12vh, 7rem));
    padding-bottom: clamp(3rem, 6vh, 5rem);
    box-sizing: border-box;
  }

  .home-v5__hero-inner {
    text-align: center;
    max-width: 1500px;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .home-v5__tagline {
    display: block;
    width: 44vw;
    max-width: 880px;
    height: auto;
    margin-inline: auto;
    margin-bottom: var(--spacing-lg);
    opacity: 0;
    transform: translateY(1.5rem);
    filter: brightness(0) invert(1);
    -webkit-mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 78%);
    -webkit-mask-size: 100% 300%;
    -webkit-mask-position: 0% 0%;
    mask-image: linear-gradient(to top, #000 0%, #000 35%, transparent 78%);
    mask-size: 100% 300%;
    mask-position: 0% 0%;
    animation: home-v5-dawn-rise 2.2s var(--ease-brand) 0.3s both;
  }

  @keyframes home-v5-dawn-rise {
    0% {
      opacity: 0;
      transform: translateY(1.5rem);
      mask-position: 0% 0%;
      -webkit-mask-position: 0% 0%;
      filter: brightness(0) invert(0.35) drop-shadow(0 0 0 rgb(214 206 188 / 0));
    }

    55% {
      opacity: 1;
      filter: brightness(0) invert(1) drop-shadow(0 0 34px rgb(214 206 188 / 0.3));
    }

    100% {
      opacity: 1;
      transform: translateY(0);
      mask-position: 0% 100%;
      -webkit-mask-position: 0% 100%;
      filter: brightness(0) invert(1) drop-shadow(0 0 18px rgb(200 208 220 / 0.14));
    }
  }

  .home-v5__subtitle {
    font-family: var(--font-brand);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 500;
    font-style: italic;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xl);
    letter-spacing: var(--tracking-subtitle);
    line-height: 1.6;
    opacity: 0;
    transform: translateY(0.75rem);
    animation: home-v5-quiet-rise 1.2s var(--ease-brand) 1.5s both;
  }

  .home-v5__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    justify-content: center;
    opacity: 0;
    transform: translateY(0.75rem);
    animation: home-v5-quiet-rise 1.2s var(--ease-brand) 1.85s both;
  }

  @keyframes home-v5-quiet-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .home-v5__cta {
    display: inline-block;
    padding: 0.875rem 2.5rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-bg);
    background-color: var(--color-text-primary);
    border: 1px solid var(--color-text-primary);
    text-decoration: none;
    transition:
      background-color var(--transition-duration-base) ease,
      color var(--transition-duration-base) ease,
      transform var(--transition-duration-fast) ease;
  }

  .home-v5__cta:hover,
  .home-v5__cta:focus-visible {
    background-color: transparent;
    color: var(--color-text-primary);
    transform: translateY(-1px);
  }

  .home-v5__cta--secondary {
    color: var(--color-text-primary);
    background-color: transparent;
  }

  .home-v5__cta--secondary:hover,
  .home-v5__cta--secondary:focus-visible {
    background-color: var(--color-text-primary);
    color: var(--color-bg);
  }

  .home-v5__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-system);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--spacing-sm);
  }

  .home-v5__title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 400;
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-heading);
    margin: 0 0 var(--spacing-md);
    line-height: 1.2;
  }

  .home-v5__title--sm {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .home-v5__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .home-v5__node-label {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-sm);
    letter-spacing: var(--tracking-card-title);
  }

  .home-v5__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .home-v5__quote {
    position: relative;
    padding: var(--spacing-md) 0 0;
    margin: 0;
    border: none;
    background: transparent;
  }

  .home-v5__node--right .home-v5__quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-top: 1px solid rgb(192 200 212 / 0.35);
    border-left: 1px solid rgb(192 200 212 / 0.35);
    pointer-events: none;
  }

  .home-v5__node--left .home-v5__quote::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-top: 1px solid rgb(192 200 212 / 0.35);
    border-right: 1px solid rgb(192 200 212 / 0.35);
    pointer-events: none;
  }

  .home-v5__quote p {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-accent);
    margin: 0;
  }

  .home-v5__assurance {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.2vw, 1rem);
    font-weight: 600;
    letter-spacing: var(--tracking-system);
    text-transform: uppercase;
    color: var(--color-text-primary);
    line-height: 1.6;
    margin: 0;
  }

  /* Node content — hidden until branch draws */
  .home-v5__node-inner,
  .home-v5__cup-grid {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.7s var(--ease-brand),
      transform 0.7s var(--ease-brand);
  }

  .home-v5__node.is-revealed .home-v5__node-inner,
  .home-v5__cup.is-revealed .home-v5__cup-grid {
    opacity: 1;
    transform: translateY(0);
  }

  /* Cup — full-width canopy */
  .home-v5__cup {
    margin-top: clamp(10rem, 16vh, 14rem);
    margin-bottom: clamp(8rem, 12vh, 10rem);
    padding-inline: var(--spacing-gutter);
    scroll-margin-top: calc(var(--site-header-height) + 1.5rem);
  }

  .home-v5__cup-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    max-width: var(--width-content-wide);
    margin-inline: auto;
  }

  .home-v5__cup-col {
    padding: var(--spacing-lg);
    background-color: var(--color-surface);
    border: 1px solid var(--color-divider);
  }

  .home-v5__teaser-cta {
    display: inline-block;
    margin-top: var(--spacing-md);
    padding: 0.75rem 2rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-bg);
    background-color: var(--color-text-primary);
    border: 1px solid var(--color-text-primary);
    text-decoration: none;
    transition:
      background-color var(--transition-duration-base) ease,
      color var(--transition-duration-base) ease;
  }

  .home-v5__teaser-cta:hover,
  .home-v5__teaser-cta:focus-visible {
    background-color: transparent;
    color: var(--color-text-primary);
  }

  /* SVG branch lines (styled via JS attributes) */
  :global(.home-v5__branch-line) {
    stroke: rgb(192 200 212 / 0.22);
    stroke-width: 0.75;
    vector-effect: non-scaling-stroke;
    fill: none;
  }

  @media (max-width: 768px) {
    .home-v5__tagline {
      width: 80vw;
      max-width: 90vw;
    }

    .home-v5__node {
      grid-template-columns: 1fr;
      margin-top: clamp(5rem, 10vh, 7rem);
    }

    .home-v5__node--left .home-v5__node-inner,
    .home-v5__node--right .home-v5__node-inner {
      grid-column: 1;
      justify-self: stretch;
      text-align: left;
      max-width: 100%;
      padding-inline: 0;
    }

    .home-v5__cup-grid {
      grid-template-columns: 1fr;
    }

    .home-v5__cta {
      padding: 0.75rem 2rem;
    }
  }

  @media (min-width: 1400px) {
    .home-v5__tagline {
      max-width: 1600px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-v5__tagline,
    .home-v5__subtitle,
    .home-v5__actions {
      animation: none;
      opacity: 1;
      transform: none;
      filter: brightness(0) invert(1);
      mask-position: 0% 100%;
      -webkit-mask-position: 0% 100%;
    }

    .home-v5__node-inner,
    .home-v5__cup-grid {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
