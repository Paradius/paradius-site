---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL, type PageSeo } from '../../lib/seo';

const seo: PageSeo = {
  title: 'Privacy Policy | Paradius LLC',
  description:
    'What the Paradius contact form collects, what we do with it, and how to have it deleted.',
  canonical: `${SITE_URL}/legal/privacy/`,
  webPageName: 'Privacy Policy',
  webPageDescription: 'Privacy policy for paradius.dev.',
};
---

<BaseLayout seo={seo}>
  <Header />
  <main class="site-main" id="main-content">
    <div class="mockup-page-wrap mockup-page-wrap--narrow legal-page">
      <h1>Privacy policy</h1>

      <h2>What we collect</h2>
      <p>
        The contact form asks for your name, email, company and message, plus any profile
        codes you attach. That is everything this site collects about you.
      </p>

      <h2>What we do with it</h2>
      <p>
        We use it to reply to you. Your inquiry is delivered to our inbox and kept as the
        record of the conversation. We do not sell it, share it, rent it, or add you to any
        marketing list.
      </p>

      <h2>Where it lives</h2>
      <p>
        This site is static and served by Vercel. Form submissions are processed by our own
        backend, hosted on Railway, and delivered to our inbox by email through Resend.
      </p>

      <h2>Cookies and analytics</h2>
      <p>
        This site sets no cookies and runs no analytics. If that ever changes, this page will
        say so first.
      </p>

      <h2>Deletion</h2>
      <p>
        Write to <a href="mailto:solutions@paradius.dev">solutions@paradius.dev</a> and we
        delete every record of your inquiry.
      </p>

      <h2>Who is responsible</h2>
      <p>
        Paradius LLC, 30 N Gould St, STE R, Sheridan, WY 82801, USA.
        <a href="mailto:solutions@paradius.dev">solutions@paradius.dev</a>.
      </p>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal-page h1 {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 400;
    letter-spacing: var(--tracking-heading);
    color: var(--color-text-primary);
    margin-block-end: var(--spacing-md);
  }

  .legal-page h2 {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-text-primary);
    margin-block: var(--spacing-md) var(--spacing-xs);
  }

  .legal-page p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-block-end: 0.75rem;
  }

  .legal-page a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .legal-page a:hover,
  .legal-page a:focus-visible {
    color: var(--color-text-primary);
  }
</style>
