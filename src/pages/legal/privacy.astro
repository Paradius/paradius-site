---
import InnerLayout from '../../layouts/InnerLayout.astro';
import InnerBlock from '../../components/inner/InnerBlock.astro';
import { SITE_URL, type PageSeo } from '../../lib/seo';

const seo: PageSeo = {
  title: 'Privacy Policy | Paradius LLC',
  description:
    'What the Paradius contact form collects, what we do with it, and how to have it deleted.',
  canonical: `${SITE_URL}/legal/privacy/`,
  webPageName: 'Privacy Policy',
  webPageDescription: 'Privacy policy for paradius.dev.',
};
---

<InnerLayout seo={seo} mode="two-sided">
  <InnerBlock force="power" kind="hero" title="Privacy policy" />

  <InnerBlock force="power" title="What we collect">
    <p>
      The contact form asks for your name, email, company and message, plus any profile
      codes you attach. When you submit it, our infrastructure also records your IP address,
      which we use for rate limiting and abuse prevention, and a hidden anti spam field
      travels with the form; humans leave it empty. That is everything this site collects
      about you.
    </p>
  </InnerBlock>

  <InnerBlock force="power" title="What we do with it">
    <p>
      We use it to reply to you and to follow up on your inquiry. Your inquiry is delivered
      to our inbox and stored in our systems, the same database that runs our sales
      pipeline, so the conversation has a record. We do not sell it, share it, or rent it.
    </p>
  </InnerBlock>

  <InnerBlock force="power" title="Where it lives">
    <p>
      This site is static and served by Vercel. Form submissions are processed by our own
      backend on Railway and delivered to our inbox through Resend. Fonts load from Google
      Fonts, which, like any content delivery network, sees your IP address and browser
      details. Nothing else leaves this site.
    </p>
  </InnerBlock>

  <InnerBlock force="power" title="Cookies and analytics">
    <p>
      This site sets no cookies and runs no analytics. If that ever changes, this page will
      say so first.
    </p>
  </InnerBlock>

  <InnerBlock force="power" title="Deletion">
    <p>
      Write to <a href="mailto:solutions@paradius.dev">solutions@paradius.dev</a> and we
      delete every record of your inquiry.
    </p>
  </InnerBlock>

  <InnerBlock force="power" kind="cta" title="Who is responsible">
    <p>
      Paradius LLC, 30 N Gould St, STE R, Sheridan, WY 82801, USA.
      <a href="mailto:solutions@paradius.dev">solutions@paradius.dev</a>.
    </p>
  </InnerBlock>
</InnerLayout>
