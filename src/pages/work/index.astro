---
import InnerLayout from '../../layouts/InnerLayout.astro';
import InnerBlock from '../../components/inner/InnerBlock.astro';
import WorkRow from '../../components/work/WorkRow.astro';
import { getCases } from '../../lib/api';
import { formatWorkStatus } from '../../lib/brand/registry';
import { buildWorkCatalogSeo } from '../../lib/seo';
import '../../styles/inner-tools.css';

const cases = await getCases();
const seo = buildWorkCatalogSeo(cases);
---

<InnerLayout seo={seo} mode="rail">
  <InnerBlock force="power" kind="hero" kicker="Work" title="See our work">
    <p>Anonymized engagements, narrated without invented numbers. What we designed, what we built, and what is still standing.</p>
  </InnerBlock>

  <InnerBlock force="power" kind="tool" ariaLabel="Case studies">
    <p class="inner-status">{formatWorkStatus(cases.length)}</p>
    <div class="inner-register inner-cases">
      {cases.map((caseStudy, index) => <WorkRow caseStudy={caseStudy} caseIndex={index + 1} />)}
    </div>
  </InnerBlock>

  <InnerBlock force="power" kind="cta" title="Assembling a cross-functional team?">
    <p>Describe who you need and we assemble the team: we reply within 24 hours.</p>
    <Fragment slot="actions">
      <a href="/contact" class="inner-button">Start your team</a>
    </Fragment>
  </InnerBlock>
</InnerLayout>

<script>
  import { mountInnerRows } from '../../scripts/inner-rows';
  mountInnerRows();
</script>
