---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScrollBehavior from '../../components/ScrollBehavior.astro';
import TalentPageHero from '../../components/talent/TalentPageHero.astro';
import WorkCaseStudy from '../../components/work/WorkCaseStudy.astro';
import { getCases } from '../../lib/api';
import { buildWorkCatalogSeo } from '../../lib/seo';

const cases = await getCases();
const seo = buildWorkCatalogSeo(cases);
---

<BaseLayout seo={seo}>
  <Header />
  <main class="site-main" id="main-content">
    <TalentPageHero
      title="See our work"
      description="Anonymized engagements, narrated without invented numbers. What we designed, what we built, and what is still standing."
    />
    <section class="work-page" aria-label="Case studies">
      <div class="work-page__cases mockup-page-wrap">
        {cases.map((caseStudy, index) => (
          <WorkCaseStudy caseStudy={caseStudy} caseIndex={index + 1} headingLevel="h2" />
        ))}
      </div>
    </section>
  </main>
  <Footer />
  <ScrollBehavior />
</BaseLayout>
