---
import InnerLayout from '../../layouts/InnerLayout.astro';
import InnerBlock from '../../components/inner/InnerBlock.astro';
import TalentConsole from '../../components/talent/TalentConsole.astro';
import TalentRow from '../../components/talent/TalentRow.astro';
import { getProfiles } from '../../lib/api';
import { buildTalentCatalogSeo } from '../../lib/seo';
import '../../styles/inner-tools.css';

const profiles = await getProfiles();
const seo = buildTalentCatalogSeo(profiles);
---

<InnerLayout seo={seo} mode="rail">
  <InnerBlock force="power" kind="hero" kicker="Registry" title="Senior nearshore engineers, vetted and presented within 48 hours.">
    <p>Filter by role, stack, seniority, and availability, then request the profiles that fit your team.</p>
  </InnerBlock>

  <InnerBlock force="power" kind="tool" ariaLabel="Talent registry">
    {profiles.length > 0 ? (
      <>
        <TalentConsole profiles={profiles} />
        <div class="inner-register" id="talent-catalog" role="list">
          {profiles.map((profile) => <TalentRow profile={profile} />)}
        </div>
        <p class="inner-empty" id="talent-empty" hidden>No profiles match these filters.</p>
      </>
    ) : (
      <div class="inner-empty">
        <p>No profiles are published right now.</p>
        <p>The registry is only one of two ways to buy. Describe who you need and we assemble the team: we reply within 24 hours.</p>
        <a href="/contact" class="inner-button">Start your team</a>
      </div>
    )}
  </InnerBlock>

  <InnerBlock force="will" id="codes" title="Why do engineers carry codes instead of names?">
    <p>
      Engineers here carry codes instead of names. That is policy, not evasion:
      anonymity protects them and keeps your systems free of our signature.
      Everything else is verifiable now: stack, years, experience, languages.
      Full identity is disclosed later in the deal, off platform.
    </p>
    <p>
      Every code is a real person, interviewed by the principal.
      <a href="/faq">More in the FAQ</a>.
    </p>
  </InnerBlock>

  <InnerBlock force="power" kind="cta" title="Assembling a cross-functional team?">
    <p>Describe who you need and we assemble the team: we reply within 24 hours.</p>
    <Fragment slot="actions">
      <a href="/contact" class="inner-button">Start your team</a>
    </Fragment>
  </InnerBlock>
</InnerLayout>

<script src="../../islands/talent-filters.ts"></script>
<script>
  import { mountInnerRows } from '../../scripts/inner-rows';
  mountInnerRows();
</script>
