---
import InnerLayout from '../../layouts/InnerLayout.astro';
import InnerBlock from '../../components/inner/InnerBlock.astro';
import ProfileDossier from '../../components/talent/ProfileDossier.astro';
import { getProfiles } from '../../lib/api';
import { buildTalentProfileSeo, buildBreadcrumbJsonLd, SITE_URL } from '../../lib/seo';
import type { AnonymousProfile } from '../../lib/api';
import '../../styles/inner-tools.css';

export async function getStaticPaths() {
  const profiles = await getProfiles();
  return profiles.map((profile) => ({
    params: { code: profile.code },
    props: { profile },
  }));
}

interface Props {
  profile: AnonymousProfile;
}

const { profile } = Astro.props;
const baseSeo = buildTalentProfileSeo(profile);
const seo = {
  ...baseSeo,
  additionalJsonLd: [
    ...(baseSeo.additionalJsonLd ?? []),
    buildBreadcrumbJsonLd([
      { name: 'Home', url: `${SITE_URL}/` },
      { name: 'Registry', url: `${SITE_URL}/talent/` },
      { name: profile.code, url: baseSeo.canonical },
    ]),
  ],
};
---

<InnerLayout seo={seo} mode="dossier">
  <InnerBlock force="power" kind="hero" title={profile.headline}>
    <Fragment slot="kicker"><a href="/talent/">Registry</a> &middot; {profile.code}</Fragment>
    <p>{profile.summary}</p>
  </InnerBlock>
  <ProfileDossier profile={profile} />
</InnerLayout>

<script>
  import { mountInnerRows } from '../../scripts/inner-rows';
  mountInnerRows();
</script>
