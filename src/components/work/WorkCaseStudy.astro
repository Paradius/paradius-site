---
import type { CaseStudy } from '../../lib/api';
import { formatCaseCode } from '../../lib/brand/registry';

interface Props {
  caseStudy: CaseStudy;
  /** 1-based position in the published catalog (for CS-00N code). */
  caseIndex: number;
  /** Use h2 when multiple cases appear on the catalog page. */
  headingLevel?: 'h1' | 'h2';
}

const { caseStudy, caseIndex, headingLevel = 'h1' } = Astro.props;
const TitleTag = headingLevel;
const idPrefix = caseStudy.slug;
const caseCode = formatCaseCode(caseIndex);
const hasMetrics = caseStudy.metrics && caseStudy.metrics.length > 0;
const hasFacts =
  caseStudy.stack.length > 0 ||
  Boolean(caseStudy.engagementDuration) ||
  Boolean(caseStudy.engagementModel);
---

<article class="work-case section-reveal">
  <header class="work-case__header">
    <p class="work-case__eyebrow">{caseCode}</p>
    <TitleTag class="work-case__title">{caseStudy.title}</TitleTag>
    <p class="work-case__client">{caseStudy.clientDescriptor}</p>

    {hasFacts && (
      <dl class="work-case__facts" aria-label="Engagement facts">
        {caseStudy.stack.length > 0 && (
          <div class="work-case__fact">
            <dt>Stack</dt>
            <dd>{caseStudy.stack.join(', ')}</dd>
          </div>
        )}
        {caseStudy.engagementDuration && (
          <div class="work-case__fact">
            <dt>Duration</dt>
            <dd>{caseStudy.engagementDuration}</dd>
          </div>
        )}
        {caseStudy.engagementModel && (
          <div class="work-case__fact">
            <dt>Model</dt>
            <dd>{caseStudy.engagementModel}</dd>
          </div>
        )}
      </dl>
    )}
  </header>

  <div class="work-case__body">
    <section class="work-case__section" aria-label={`Problem: ${caseStudy.title}`}>
      <h2 id={`${idPrefix}-problem-heading`} class="work-case__section-title">Problem</h2>
      <p class="work-case__text">{caseStudy.problem}</p>
    </section>

    <section class="work-case__section" aria-label={`Solution: ${caseStudy.title}`}>
      <h2 id={`${idPrefix}-solution-heading`} class="work-case__section-title">Solution</h2>
      <p class="work-case__text">{caseStudy.solution}</p>
    </section>

    <section class="work-case__section" aria-label={`Outcome: ${caseStudy.title}`}>
      <h2 id={`${idPrefix}-outcome-heading`} class="work-case__section-title">Outcome</h2>
      <p class="work-case__text">{caseStudy.outcome}</p>
    </section>

    {hasMetrics && (
      <div class="work-case__metrics" aria-label="Key metrics">
        {caseStudy.metrics.map((metric) => (
          <div class="work-case__metric">
            <span class="work-case__metric-value">{metric.value}</span>
            <span class="work-case__metric-label">{metric.label}</span>
          </div>
        ))}
      </div>
    )}

    {caseStudy.leftBehind && (
      <section class="work-case__section work-case__section--left-behind" aria-label={`What we left behind: ${caseStudy.title}`}>
        <h2 class="work-case__section-title">What we left behind</h2>
        <p class="work-case__text">{caseStudy.leftBehind}</p>
      </section>
    )}
  </div>

  <footer class="work-case__footer work-case__mirror">
    <p class="work-case__mirror-text">If your operation looks like this, we should talk.</p>
    <a href="/contact" class="work-case__cta work-case__mirror-cta">Start your team</a>
  </footer>
</article>

<style>
  .work-case__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md) var(--spacing-xl);
    margin: var(--spacing-lg) 0 0;
  }

  .work-case__fact dt {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-text-secondary);
    margin: 0 0 0.25rem;
  }

  .work-case__fact dd {
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    margin: 0;
  }

  .work-case__mirror-text {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .work-case__mirror-cta {
    background-color: transparent;
    transition:
      background-color var(--transition-duration-base) ease,
      border-color var(--transition-duration-base) ease,
      color var(--transition-duration-base) ease;
  }

  .work-case__mirror-cta:hover,
  .work-case__mirror-cta:focus-visible {
    background-color: var(--color-text-primary);
    border-color: var(--color-text-primary);
    color: var(--color-bg);
  }
</style>
