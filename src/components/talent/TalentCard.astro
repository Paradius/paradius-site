---
import type { AnonymousProfile } from '../../lib/api';
import {
  formatAvailability,
  formatSeniority,
  formatStackTag,
  overflowStackCount,
  topStackTags,
} from '../../lib/talent/formatters';

interface Props {
  profile: AnonymousProfile;
}

const { profile } = Astro.props;
const availability = formatAvailability(profile.availability);
const visibleStack = topStackTags(profile, 6);
const overflow = overflowStackCount(profile, 6);
const profileUrl = `/talent/${profile.code}/`;
---

<article
  class="talent-card-b card talent-card"
  data-talent-card
  data-roles={profile.roles.join(' ')}
  data-seniority={profile.seniority}
  data-availability={profile.availability}
  data-stack={profile.stack.join(' ')}
>
  <div class="talent-card-b__header">
    <span class="talent-card-b__code">{profile.code}</span>
    <span class={`badge ${availability.modifier}`}>{availability.label}</span>
  </div>
  <h2 class="talent-card-b__headline">
    <a href={profileUrl} class="talent-card__link">{profile.headline}</a>
  </h2>
  <p class="talent-card-b__meta">
    {formatSeniority(profile.seniority)} · {profile.yearsExperience} years experience
  </p>
  <div class="talent-card-b__tags" aria-label="Primary stack">
    {
      visibleStack.map((tag) => (
        <span class="chip">{formatStackTag(tag)}</span>
      ))
    }
    {overflow > 0 && <span class="chip chip--muted">+{overflow}</span>}
  </div>
  <a href={profileUrl} class="talent-card-b__cta">View profile</a>
</article>
