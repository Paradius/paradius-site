---
import type { AnonymousProfile, Availability, DeveloperRole, Seniority } from '../../lib/api';
import { formatRegistryStatus } from '../../lib/brand/registry';
import { collectRoles, collectStackTags, formatRole, formatSeniority } from '../../lib/talent/formatters';

interface Props {
  profiles: readonly AnonymousProfile[];
}

const { profiles } = Astro.props;
const roles = collectRoles(profiles);
const stackTags = collectStackTags(profiles);
const seniorityOptions: Seniority[] = ['junior', 'mid', 'senior', 'staff'];
const availabilityOptions: Availability[] = ['available', 'soon', 'unavailable'];
const availabilityLabels: Record<Availability, string> = {
  available: 'Available now',
  soon: 'Available soon',
  unavailable: 'Currently assigned',
};
---

<p class="inner-status" id="talent-filter-status" aria-live="polite">{formatRegistryStatus(profiles.length)}</p>
<div class="inner-console" id="talent-filters" role="search" aria-label="Catalog filters" aria-controls="talent-catalog">
  <div class="inner-group" role="group" aria-labelledby="talent-legend-role" data-filter-group="role">
    <p class="inner-legend" id="talent-legend-role">Role</p>
    <div class="inner-pills">
      <button type="button" class="inner-pill" data-filter="role" data-value="" aria-pressed="true">All</button>
      {roles.map((role: DeveloperRole) => (
        <button type="button" class="inner-pill" data-filter="role" data-value={role} aria-pressed="false">{formatRole(role)}</button>
      ))}
    </div>
  </div>
  <div class="inner-group" role="group" aria-labelledby="talent-legend-seniority" data-filter-group="seniority">
    <p class="inner-legend" id="talent-legend-seniority">Seniority</p>
    <div class="inner-pills">
      <button type="button" class="inner-pill" data-filter="seniority" data-value="" aria-pressed="true">All</button>
      {seniorityOptions.map((seniority) => (
        <button type="button" class="inner-pill" data-filter="seniority" data-value={seniority} aria-pressed="false">{formatSeniority(seniority)}</button>
      ))}
    </div>
  </div>
  <div class="inner-group" role="group" aria-labelledby="talent-legend-availability" data-filter-group="availability">
    <p class="inner-legend" id="talent-legend-availability">Availability</p>
    <div class="inner-pills">
      <button type="button" class="inner-pill" data-filter="availability" data-value="" aria-pressed="true">All</button>
      {availabilityOptions.map((availability) => (
        <button type="button" class="inner-pill" data-filter="availability" data-value={availability} aria-pressed="false">{availabilityLabels[availability]}</button>
      ))}
    </div>
  </div>
  <div class="inner-group inner-group--search" data-filter-group="stack">
    <label class="inner-legend" for="talent-stack-search">Stack</label>
    <input id="talent-stack-search" class="inner-search" type="search" name="stack" placeholder="Search stack (e.g. flutter, go)" autocomplete="off" list="talent-stack-suggestions" />
    <datalist id="talent-stack-suggestions">{stackTags.map((tag) => <option value={tag} />)}</datalist>
  </div>
</div>
