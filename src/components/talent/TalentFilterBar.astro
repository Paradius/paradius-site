---
import type { AnonymousProfile } from '../../lib/api';
import { formatRegistryStatus } from '../../lib/brand/registry';
import {
  collectRoles,
  collectStackTags,
  formatRole,
  formatSeniority,
} from '../../lib/talent/formatters';
import type { Availability, DeveloperRole, Seniority } from '../../lib/api';

interface Props {
  profiles: readonly AnonymousProfile[];
}

const { profiles } = Astro.props;

const roles = collectRoles(profiles);
const stackTags = collectStackTags(profiles);

const seniorityOptions: Seniority[] = ['junior', 'mid', 'senior', 'staff'];
const availabilityOptions: Availability[] = ['available', 'soon', 'unavailable'];

const availabilityLabels: Record<Availability, string> = {
  available: 'Available now',
  soon: 'Available soon',
  unavailable: 'Currently assigned',
};
---

<div
  id="talent-filters"
  class="filters section-reveal"
  role="search"
  aria-label="Catalog filters"
  aria-controls="talent-catalog"
>
  <div class="filters__container">
    <p class="filters__hint" id="talent-filter-status" aria-live="polite">
      {formatRegistryStatus(profiles.length)}
    </p>
    <div class="filters__groups">
      <fieldset class="filters__group" data-filter-group="role">
        <legend class="filters__legend">Role</legend>
        <div class="filters__pills">
          <button
            type="button"
            class="filters__pill filters__pill--active"
            data-filter="role"
            data-value=""
            aria-pressed="true"
          >
            All
          </button>
          {
            roles.map((role: DeveloperRole) => (
              <button
                type="button"
                class="filters__pill"
                data-filter="role"
                data-value={role}
                aria-pressed="false"
              >
                {formatRole(role)}
              </button>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="filters__group" data-filter-group="seniority">
        <legend class="filters__legend">Seniority</legend>
        <div class="filters__pills">
          <button
            type="button"
            class="filters__pill filters__pill--active"
            data-filter="seniority"
            data-value=""
            aria-pressed="true"
          >
            All
          </button>
          {
            seniorityOptions.map((seniority) => (
              <button
                type="button"
                class="filters__pill"
                data-filter="seniority"
                data-value={seniority}
                aria-pressed="false"
              >
                {formatSeniority(seniority)}
              </button>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="filters__group" data-filter-group="availability">
        <legend class="filters__legend">Availability</legend>
        <div class="filters__pills">
          <button
            type="button"
            class="filters__pill filters__pill--active"
            data-filter="availability"
            data-value=""
            aria-pressed="true"
          >
            All
          </button>
          {
            availabilityOptions.map((availability) => (
              <button
                type="button"
                class="filters__pill"
                data-filter="availability"
                data-value={availability}
                aria-pressed="false"
              >
                {availabilityLabels[availability]}
              </button>
            ))
          }
        </div>
      </fieldset>

      <div class="filters__group filters__group--search">
        <label class="filters__legend" for="talent-stack-search">Stack</label>
        <input
          id="talent-stack-search"
          class="filters__search"
          type="search"
          name="stack"
          placeholder="Search stack (e.g. flutter, go)"
          autocomplete="off"
          list="talent-stack-suggestions"
        />
        <datalist id="talent-stack-suggestions">
          {stackTags.map((tag) => <option value={tag} />)}
        </datalist>
      </div>
    </div>
  </div>
</div>
