---
import type { AnonymousProfile } from '../../lib/api';
import { formatAvailability, formatExperienceRange, formatExperienceYears, formatLanguage, formatSeniority, formatStackTag } from '../../lib/talent/formatters';
import Branch from '../inner/Branch.astro';
import InnerBlock from '../inner/InnerBlock.astro';

interface Props {
  profile: AnonymousProfile;
}

const { profile } = Astro.props;
const availability = formatAvailability(profile.availability);
const contactUrl = `/contact?profile=${encodeURIComponent(profile.code)}`;
---

<div class="inner-pair">
  <InnerBlock force="power" kind="tool" ariaLabel="Profile facts" className="inner-pair__facts">
    <div class="inner-console" aria-label="Profile facts">
      <div class="inner-group">
        <p class="inner-legend">Availability</p>
        <div class="inner-pills"><span class="inner-badge" data-availability={profile.availability}>{availability.label}</span><span class="inner-pill">Profiles presented within 48 hours</span></div>
      </div>
      <div class="inner-group">
        <p class="inner-legend">Seniority</p>
        <div class="inner-pills"><span class="inner-pill">{formatSeniority(profile.seniority)} · {profile.yearsExperience} years</span></div>
      </div>
      <div class="inner-group">
        <p class="inner-legend">Stack</p>
        <div class="inner-pills">{profile.stack.map((tag) => <span class="inner-pill">{formatStackTag(tag)}</span>)}</div>
      </div>
      <div class="inner-group">
        <p class="inner-legend">Languages</p>
        <div class="inner-pills">{profile.languages.map((lang) => <span class="inner-pill">{formatLanguage(lang)}</span>)}</div>
      </div>
    </div>
  </InnerBlock>

  <InnerBlock force="will" kind="tool" ariaLabel="Experience" className="inner-pair__jobs">
    <ol class="inner-register inner-jobs inner-register--still inner-register--under" role="list">
      {profile.experience.map((entry) => (
        <li class="inner-row">
          <Branch fan="junior" />
          <span class="inner-row__code">{formatExperienceYears(entry)}</span>
          <span class="inner-row__title">{entry.role}</span>
          <span class="inner-row__graft"><span class="inner-row__meta">{entry.industryDescriptor}</span><span class="inner-row__dates">{formatExperienceRange(entry)}</span></span>
          {entry.achievements.length > 0 && (
            <ul class="inner-row__feats">{entry.achievements.map((achievement) => <li>{achievement}</li>)}</ul>
          )}
        </li>
      ))}
    </ol>
  </InnerBlock>

  <InnerBlock force="power" title={`Want ${profile.code} on your team?`} className="inner-pair__ask">
    <p>Tell us about the role. We present the profile within 48 hours.</p>
    <Fragment slot="actions">
      <a href={contactUrl} class="inner-button">Request this profile</a>
    </Fragment>
  </InnerBlock>
</div>

<InnerBlock force="power" kind="cta" className="inner-note" title="Why does this engineer carry a code instead of a name?">
  <p>
    Policy: the code protects the engineer and keeps your systems free of our signature.
    Everything you can verify is on this page; the name comes later in the deal, off
    platform. <a href="/faq">More in the FAQ</a>.
  </p>
</InnerBlock>
