---
/** Hero — tagline SVG, commercial subtitle (D10), benefit-driven CTA. */
---

<section
  class="hero"
  data-station="roots"
  data-side="full"
  aria-labelledby="hero-heading"
>
  <div class="hero__container">
    <h1 id="hero-heading" class="sr-only">
      Paradius — Architecting the Dawn from Within | Software Engineering Consultancy
    </h1>
    <img
      class="hero__tagline"
      src="/assets/architecting_the_dawn_from_within.svg"
      alt="Paradius: Architecting the Dawn from Within"
      width="288"
      height="97"
      fetchpriority="high"
      decoding="async"
      data-block
    />
    <p class="hero__subtitle" data-block>
      Curated talent drafting the future’s blueprint
    </p>
    <div class="hero__actions" data-block>
      <a href="/talent" class="hero__cta">Browse the registry</a>
      <a href="/contact" class="hero__cta hero__cta--secondary">Start your team</a>
    </div>
  </div>
</section>
