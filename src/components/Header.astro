---
import ParadiusLogo from './ParadiusLogo.astro';
---

<header class="site-header" id="header">
  <div class="site-header__container">
    <a href="/" class="site-header__logo" aria-label="Paradius, Home" title="Paradius LLC">
      <ParadiusLogo class="site-header__logo-svg" />
    </a>
    <nav class="site-header__nav" id="site-nav" aria-label="Main navigation">
      <ul class="site-header__nav-list">
        <li><a href="/talent" class="site-header__nav-link">Registry</a></li>
        <li><a href="/work" class="site-header__nav-link">Work</a></li>
        <li><a href="/how-we-work" class="site-header__nav-link">How we work</a></li>
        <li><a href="/about" class="site-header__nav-link">About</a></li>
        <li><a href="/contact" class="site-header__nav-link">Contact</a></li>
      </ul>
    </nav>
    <button
      class="site-header__menu-toggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="site-header__menu-bar"></span>
      <span class="site-header__menu-bar"></span>
    </button>
  </div>
</header>

<script is:inline>
  /* Menu toggle lives with the header so every page that renders it has a
     working nav, including pages that do not load ScrollBehavior. */
  (function () {
    'use strict';

    const toggle = document.querySelector('.site-header__menu-toggle');
    const nav = document.querySelector('.site-header__nav');
    if (!toggle || !nav || toggle.dataset.menuBound === 'true') return;
    toggle.dataset.menuBound = 'true';

    const htmlEl = document.documentElement;
    toggle.addEventListener('click', function () {
      const isOpen = nav.classList.toggle('site-header__nav--open');
      toggle.classList.toggle('site-header__menu-toggle--active', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      htmlEl.classList.toggle('menu-open', isOpen);
    });
  })();
</script>
