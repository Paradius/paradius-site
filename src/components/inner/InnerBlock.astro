---
interface Props {
  force: 'will' | 'power';
  kind?: 'hero' | 'block' | 'cta' | 'tool';
  id?: string;
  kicker?: string;
  title?: string;
  ariaLabel?: string;
}

const { force, kind = 'block', id, kicker, title, ariaLabel } = Astro.props;
const Heading = kind === 'hero' ? 'h1' : 'h2';
const classes = ['inner-block', kind === 'hero' && 'inner-block--hero', kind === 'cta' && 'inner-block--cta'].filter(Boolean).join(' ');
const hasActions = Astro.slots.has('actions');
---

{kind === 'tool' ? (
  <section class="inner-block inner-block--tool" data-force={force} id={id} aria-label={ariaLabel}><slot /></section>
) : (
<section class={classes} data-force={force} id={id} aria-label={ariaLabel}>
  {kind === 'cta' ? (
    <div class="inner-block__inner">
      {kicker && <p class="inner-kicker">{kicker}</p>}
      {title && <Heading class="inner-title">{title}</Heading>}
      <div class="inner-body"><slot /></div>
      {hasActions && <div class="inner-actions"><slot name="actions" /></div>}
    </div>
  ) : (
    <>
      {kicker && <p class="inner-kicker">{kicker}</p>}
      {title && <Heading class="inner-title">{title}</Heading>}
      <div class="inner-body"><slot /></div>
      {hasActions && <div class="inner-actions"><slot name="actions" /></div>}
    </>
  )}
</section>
)}
