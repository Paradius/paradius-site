---
import { CONTACT_EMAIL, HONEYPOT_FIELD } from '../../lib/contact/constants';

interface Props {
  apiBaseUrl: string;
}

const { apiBaseUrl } = Astro.props;
const apiConfigured = apiBaseUrl.trim().length > 0;
---

<div class="inner-form" data-contact-form data-api-base-url={apiBaseUrl} data-api-configured={apiConfigured ? 'true' : 'false'}>
  <div class="inner-form__status" data-status="success" hidden role="status" aria-live="polite">
    <p class="inner-form__status-title">Inquiry sent</p>
    <p class="inner-form__status-text">Thank you. We reply within 24 hours.</p>
  </div>

  <div class="inner-form__status inner-form__status--error" data-status="error" hidden role="alert" aria-live="assertive">
    <p class="inner-form__status-title" data-error-title>Something went wrong</p>
    <p class="inner-form__status-text" data-error-message></p>
    <p class="inner-form__status-text" data-error-fallback hidden>
      Prefer email?
      <a data-mailto-fallback href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  </div>

  <form id="lead-form" novalidate aria-label="Contact form">
    <div class="inner-field" data-field="name">
      <label class="inner-legend" for="contact-name">Name</label>
      <input class="inner-input" type="text" id="contact-name" name="name" autocomplete="name" required placeholder="Your name" />
      <p class="inner-form__error" id="contact-name-error" data-field-error="name" hidden></p>
    </div>

    <div class="inner-field" data-field="email">
      <label class="inner-legend" for="contact-email">Email</label>
      <input class="inner-input" type="email" id="contact-email" name="email" autocomplete="email" required placeholder="you@company.com" />
      <p class="inner-form__error" id="contact-email-error" data-field-error="email" hidden></p>
    </div>

    <div class="inner-field" data-field="company">
      <label class="inner-legend" for="contact-company">Company</label>
      <input class="inner-input" type="text" id="contact-company" name="company" autocomplete="organization" required placeholder="Company name" />
      <p class="inner-form__error" id="contact-company-error" data-field-error="company" hidden></p>
    </div>

    <div class="inner-field" data-field="profiles" hidden>
      <span class="inner-legend" id="contact-profiles-label">Profiles</span>
      <div class="inner-pills" id="contact-profile-chips" role="list" aria-labelledby="contact-profiles-label" data-profile-chips></div>
      <p class="inner-hint" data-profile-hint>Profiles you open in the registry appear here.</p>
    </div>

    <div class="inner-field" data-field="message">
      <label class="inner-legend" for="contact-message">Message</label>
      <textarea class="inner-input inner-input--area" id="contact-message" name="message" rows={5} required placeholder="Describe your team needs, timeline, and tech stack..."></textarea>
      <p class="inner-form__error" id="contact-message-error" data-field-error="message" hidden></p>
    </div>

    <div class="inner-form__honeypot" aria-hidden="true">
      <label for="contact-website">Website</label>
      <input type="text" id="contact-website" name={HONEYPOT_FIELD} tabindex={-1} autocomplete="off" />
    </div>

    <div class="inner-actions">
      <button type="submit" class="inner-button" data-submit data-idle-label={apiConfigured ? 'Send inquiry' : 'Send by email'}>{apiConfigured ? 'Send inquiry' : 'Send by email'}</button>
    </div>

    <p class="inner-hint">Your data goes only where our <a href="/legal/privacy">privacy policy</a> says it goes.</p>
  </form>

  <noscript>
    <p class="inner-hint">
      Email us at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
    </p>
  </noscript>
</div>
