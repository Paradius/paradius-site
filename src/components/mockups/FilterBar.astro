---
/** Static filter bar UI — visual only, non-functional in mockups. */
---

<div class="mockup-filters section-reveal" aria-label="Catalog filters (preview only)">
  <div class="mockup-filters__container">
    <p class="mockup-filters__hint">Filters preview — interactive filtering ships in S3</p>
    <div class="mockup-filters__groups">
      <fieldset class="mockup-filters__group">
        <legend class="mockup-filters__legend">Stack</legend>
        <div class="mockup-filters__pills">
          <span class="mockup-filters__pill mockup-filters__pill--active">All</span>
          <span class="mockup-filters__pill">Flutter</span>
          <span class="mockup-filters__pill">Go</span>
          <span class="mockup-filters__pill">React</span>
          <span class="mockup-filters__pill">Kubernetes</span>
        </div>
      </fieldset>
      <fieldset class="mockup-filters__group">
        <legend class="mockup-filters__legend">Seniority</legend>
        <div class="mockup-filters__pills">
          <span class="mockup-filters__pill mockup-filters__pill--active">All</span>
          <span class="mockup-filters__pill">Senior</span>
          <span class="mockup-filters__pill">Staff</span>
          <span class="mockup-filters__pill">Mid</span>
        </div>
      </fieldset>
      <fieldset class="mockup-filters__group">
        <legend class="mockup-filters__legend">Availability</legend>
        <div class="mockup-filters__pills">
          <span class="mockup-filters__pill mockup-filters__pill--active">All</span>
          <span class="mockup-filters__pill">Available now</span>
          <span class="mockup-filters__pill">Soon</span>
        </div>
      </fieldset>
    </div>
  </div>
</div>
