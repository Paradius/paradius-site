---
import type { AnonymousProfile } from '../../lib/api';
import {
  formatExperienceRange,
  formatSeniority,
  formatStackTag,
} from '../../lib/talent/formatters';

interface Props {
  profile: AnonymousProfile;
}

const { profile } = Astro.props;
---

<article class="profile-editorial-a section-reveal">
  <header class="profile-editorial-a__header">
    <p class="profile-editorial-a__code">{profile.code}</p>
    <h1 class="profile-editorial-a__headline">{profile.headline}</h1>
    <p class="profile-editorial-a__meta">
      {formatSeniority(profile.seniority)} · {profile.yearsExperience} years · Presentable within 48 hours
    </p>
    <p class="profile-editorial-a__summary">{profile.summary}</p>
    <a href="#" class="profile-editorial-a__cta" aria-disabled="true">Request this profile</a>
  </header>

  <section class="profile-editorial-a__experience" aria-labelledby="experience-heading-a">
    <h2 id="experience-heading-a" class="profile-editorial-a__section-title">Experience</h2>
    <ol class="profile-editorial-a__timeline">
      {
        profile.experience.map((entry) => (
          <li class="profile-editorial-a__entry">
            <div class="profile-editorial-a__entry-header">
              <h3 class="profile-editorial-a__role">{entry.role}</h3>
              <time class="profile-editorial-a__dates" datetime={entry.startDate}>
                {formatExperienceRange(entry)}
              </time>
            </div>
            <p class="profile-editorial-a__industry">{entry.industryDescriptor}</p>
            <ul class="profile-editorial-a__achievements">
              {entry.achievements.map((achievement) => (
                <li>{achievement}</li>
              ))}
            </ul>
            {
              entry.stack.length > 0 && (
                <p class="profile-editorial-a__stack">
                  {entry.stack.map(formatStackTag).join(' · ')}
                </p>
              )
            }
          </li>
        ))
      }
    </ol>
  </section>
</article>
