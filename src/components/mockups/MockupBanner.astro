---
interface Props {
  variantLabel?: string;
}

const { variantLabel } = Astro.props;
---

<div class="mockup-banner" role="note">
  <div class="mockup-banner__container">
    <p class="mockup-banner__text">
      <span class="mockup-banner__label">Design mockup</span>
      — Phase S2.5 · awaiting approval
      {variantLabel && <span class="mockup-banner__variant"> · {variantLabel}</span>}
    </p>
    <a href="/mockups/" class="mockup-banner__link">All mockups</a>
  </div>
</div>
