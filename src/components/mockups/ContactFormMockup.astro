---
/** Static contact form mockup — fields visual only, chips are non-removable. */
const interestedProfiles = ['PRD-001', 'PRD-003'];
---

<section class="contact-mockup section-reveal">
  <div class="contact-mockup__intro">
    <p class="contact-mockup__eyebrow">Start a conversation</p>
    <h1 class="contact-mockup__title">Build your team</h1>
    <p class="contact-mockup__description">
      Tell us who you need. We reply within 24 hours with vetted profiles — senior engineers
      ready to present within 48 hours. No pricing on the site; we scope rates in private conversation.
    </p>
  </div>

  <form class="contact-mockup__form" aria-label="Contact form (preview only)">
    <div class="contact-mockup__field">
      <label class="contact-mockup__label" for="contact-name">Name</label>
      <input
        class="contact-mockup__input"
        type="text"
        id="contact-name"
        name="name"
        placeholder="Your name"
        disabled
      />
    </div>

    <div class="contact-mockup__field">
      <label class="contact-mockup__label" for="contact-email">Email</label>
      <input
        class="contact-mockup__input"
        type="email"
        id="contact-email"
        name="email"
        placeholder="you@company.com"
        disabled
      />
    </div>

    <div class="contact-mockup__field">
      <label class="contact-mockup__label" for="contact-company">Company</label>
      <input
        class="contact-mockup__input"
        type="text"
        id="contact-company"
        name="company"
        placeholder="Company name"
        disabled
      />
    </div>

    <div class="contact-mockup__field">
      <span class="contact-mockup__label" id="contact-profiles-label">Interested profiles</span>
      <div class="contact-mockup__chips" role="list" aria-labelledby="contact-profiles-label">
        {
          interestedProfiles.map((code) => (
            <span class="contact-mockup__chip" role="listitem">
              <span class="contact-mockup__chip-code">{code}</span>
              <span class="contact-mockup__chip-remove" aria-hidden="true">×</span>
            </span>
          ))
        }
      </div>
      <p class="contact-mockup__hint">Pre-filled from catalog — removable chips ship in S5</p>
    </div>

    <div class="contact-mockup__field">
      <label class="contact-mockup__label" for="contact-message">Message</label>
      <textarea
        class="contact-mockup__textarea"
        id="contact-message"
        name="message"
        rows={5}
        placeholder="Describe your team needs, timeline, and tech stack..."
        disabled
      ></textarea>
    </div>

    <button type="button" class="contact-mockup__submit" disabled>Send inquiry</button>
    <p class="contact-mockup__fallback">
      Prefer email?
      <a href="mailto:solutions@paradius.dev">solutions@paradius.dev</a>
    </p>
  </form>
</section>
