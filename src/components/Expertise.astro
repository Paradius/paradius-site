---
/** Expertise cards — ported 1:1 from the live landing. */

const cards = [
  {
    title: 'System Architecture',
    description:
      'Every decision at the foundation echoes through the lifetime of a product. We design systems from the architecture up — scalable, maintainable, and built to evolve with your business rather than against it.',
    icon: 'architecture',
  },
  {
    title: 'Cross-Platform Engineering',
    description:
      'Native-quality experiences on every platform, from a single source of truth. We choose the right technology for the problem — then execute it with the discipline that turns a good idea into a lasting product.',
    icon: 'mobile',
  },
  {
    title: 'Technical Integrity',
    description:
      'We review every line. We test what matters. We document what others skip. Not because a process demands it, but because the engineers here hold themselves to that standard.',
    icon: 'integrity',
  },
] as const;
---

<section class="expertise" id="expertise" data-station="expertise" data-side="left" aria-labelledby="expertise-heading">
  <div class="expertise__container">
    <h2 class="expertise__title" id="expertise-heading" data-block>What Paradius Architects</h2>
    <p class="expertise__subtitle" data-block>
      Architecture-first software development, delivered by senior engineers who care about what
      they leave behind.
    </p>
    <div class="expertise__grid">
      {
        cards.map((card) => (
          <article class="card" data-block>
            <div class="card__icon" aria-hidden="true">
              {card.icon === 'architecture' && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect
                    x="8"
                    y="8"
                    width="32"
                    height="32"
                    rx="4"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <rect
                    x="14"
                    y="14"
                    width="8"
                    height="8"
                    rx="1"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <rect
                    x="26"
                    y="14"
                    width="8"
                    height="8"
                    rx="1"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <rect
                    x="14"
                    y="26"
                    width="8"
                    height="8"
                    rx="1"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <rect
                    x="26"
                    y="26"
                    width="8"
                    height="8"
                    rx="1"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                </svg>
              )}
              {card.icon === 'mobile' && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect
                    x="12"
                    y="4"
                    width="24"
                    height="40"
                    rx="4"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <line x1="12" y1="12" x2="36" y2="12" stroke="currentColor" stroke-width="1.5" />
                  <line x1="12" y1="36" x2="36" y2="36" stroke="currentColor" stroke-width="1.5" />
                  <circle cx="24" cy="40" r="1.5" fill="currentColor" />
                </svg>
              )}
              {card.icon === 'integrity' && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M24 4L6 14v20l18 10 18-10V14L24 4z"
                    stroke="currentColor"
                    stroke-width="1.5"
                    fill="none"
                  />
                  <path d="M24 24L6 14" stroke="currentColor" stroke-width="1.5" />
                  <path d="M24 24l18-10" stroke="currentColor" stroke-width="1.5" />
                  <path d="M24 24v20" stroke="currentColor" stroke-width="1.5" />
                </svg>
              )}
            </div>
            <h3 class="card__title">{card.title}</h3>
            <p class="card__description">{card.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
