{
  "name": "paradius-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Paradius public site — Astro + Tailwind, fully static",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && cp dist/sitemap-0.xml dist/sitemap.xml",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit && eslint .",
    "test": "vitest run",
    "lint": "eslint .",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "audit:axe": "node scripts/axe-audit.mjs",
    "tree:pieces": "vite-node scripts/tree-pieces.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/cli": "^4.12.1",
    "@axe-core/playwright": "^4.12.1",
    "@tailwindcss/vite": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "lighthouse": "^12.8.2",
    "pa11y-ci": "^4.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
